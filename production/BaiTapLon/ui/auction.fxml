<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>

<VBox spacing="10" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="client.AuctionController">

    <TextField fx:id="bidInput" promptText="Enter bid"/>
    <Button text="Bid" onAction="#handleBid"/>
    <TextArea fx:id="logArea"/>

    <Label fx:id="currentPriceLabel" text="Current Price: 0" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

</VBox>

