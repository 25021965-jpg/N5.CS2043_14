<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<HBox
        maxHeight="-Infinity"
        maxWidth="-Infinity"
        minHeight="-Infinity"
        minWidth="-Infinity"
        prefHeight="850.0"
        prefWidth="1100.0"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="client.controller.ForgotPassController"
        style="
        -fx-border-color: #D4AF37;
        -fx-border-width: 6;
    ">

    <!-- LEFT SIDE -->
    <VBox alignment="CENTER" prefHeight="650.0" prefWidth="480.0" style="-fx-background-color: #B71C1C;"
          HBox.hgrow="ALWAYS">

        <ImageView fitHeight="550.0" fitWidth="480.0" pickOnBounds="true" preserveRatio="true">

            <Image url="@../image/forgotpas.png"/>
        </ImageView>

    </VBox>

    <!-- RIGHT SIDE -->
    <VBox alignment="CENTER" prefHeight="650.0" prefWidth="620.0" spacing="16.0" style="-fx-background-color: #121212;"
          HBox.hgrow="ALWAYS">

        <!-- TITLE -->
        <Label style="-fx-text-fill: white;                           -fx-font-size: 38px;                           -fx-font-weight: bold;"
               text="FORGOT PASSWORD">

            <font>
                <Font name="Berlin Sans FB Demi Bold" size="38.0"/>
            </font>

            <textFill>
                <LinearGradient cycleMethod="REFLECT" endY="0.5">

                    <stops>

                        <Stop>
                            <color>
                                <Color red="1.0" green="1.0" blue="1.0"/>
                            </color>
                        </Stop>

                        <Stop offset="1.0">
                            <color>
                                <Color red="0.83" green="0.69" blue="0.22"/>
                            </color>
                        </Stop>

                    </stops>

                </LinearGradient>
            </textFill>

        </Label>

        <!-- DESCRIPTION -->
        <Label style="-fx-text-fill: #BDBDBD;                           -fx-font-size: 14px;"
               text="Please re-enter all registered information"/>

        <!-- FULL NAME -->
        <TextField fx:id="fullNameField" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
                   minWidth="-Infinity" prefHeight="37.0" prefWidth="380.0" promptText="Full name"
                   style="-fx-background-color: white;                               -fx-background-radius: 5;">

            <opaqueInsets>
                <Insets/>
            </opaqueInsets>

        </TextField>

        <!-- DATE OF BIRTH -->
        <DatePicker fx:id="dobField" prefHeight="37.0" prefWidth="380.0" promptText="Date of Birth"
                    style="-fx-background-color: white;                                -fx-background-radius: 5;"/>

        <!-- USERNAME -->
        <TextField fx:id="usernameField" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
                   minWidth="-Infinity" prefHeight="37.0" prefWidth="380.0" promptText="Username"
                   style="-fx-background-color: white;                               -fx-background-radius: 5;"/>

        <!-- EMAIL -->
        <TextField fx:id="emailField" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
                   minWidth="-Infinity" prefHeight="37.0" prefWidth="380.0" promptText="Email"
                   style="-fx-background-color: white;                               -fx-background-radius: 5;"/>

        <!-- NEW PASSWORD -->
        <PasswordField fx:id="newPasswordField" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
                       minWidth="-Infinity" prefHeight="37.0" prefWidth="380.0" promptText="New Password"
                       style="-fx-background-color: white;                                   -fx-background-radius: 5;"/>

        <!-- VERIFY PASSWORD -->
        <PasswordField fx:id="verifyPasswordField" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
                       minWidth="-Infinity" prefHeight="37.0" prefWidth="380.0" promptText="Verify New Password"
                       style="-fx-background-color: white;                                   -fx-background-radius: 5;"/>

        <!-- RESET BUTTON -->
        <Button onAction="#handleResetPassword" prefHeight="40.0" prefWidth="380.0"
                style="-fx-background-color: #2C2C2C;                            -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 5;"
                text="RESET PASSWORD">

            <font>
                <Font name="Berlin Sans FB Demi Bold" size="18.0"/>
            </font>

        </Button>

        <!-- BACK BUTTON -->
        <Button  onAction="#handleBack" prefHeight="40.0" maxWidth="380.0"
                style="-fx-background-color: #2C2C2C;                            -fx-text-fill: white;                            -fx-font-weight: bold;                            -fx-background-radius: 5;"
                text="BACK TO LOGIN">

            <font>
                <Font name="Berlin Sans FB Demi Bold" size="18.0"/>
            </font>

        </Button>

    </VBox>

</HBox>
