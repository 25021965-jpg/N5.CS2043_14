<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane
        style="-fx-background-color: #121212;"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="client.controller.ItemViewController">

   <!-- ================= TOP ================= -->
   <top>
      <VBox
              spacing="10"
              style="
                    -fx-background-color: #1A1A1A;
                    -fx-border-color: #D4AF37;
                    -fx-border-width: 0 0 2 0;
                ">

         <padding>
            <Insets
                    bottom="20"
                    left="30"
                    top="20"/>
         </padding>

         <Label
                 fx:id="lblName"
                 text="Item Information"
                 textFill="#D4AF37">
            <font>
               <Font
                       name="Arial Bold"
                       size="34.0"/>
            </font>
         </Label>

      </VBox>
   </top>

   <!-- ================= LEFT IMAGE ================= -->
   <left>
      <VBox
              alignment="CENTER"
              minWidth="420"
              prefWidth="480"
              maxWidth="550"
              spacing="20">

         <padding>
            <Insets
                    left="40"
                    top="30"/>
         </padding>

         <StackPane
                 fx:id="imageContainer"
                 minHeight="380"
                 minWidth="380"
                 prefHeight="420"
                 prefWidth="420"
                 maxHeight="500"
                 maxWidth="500"
                 style="
                     -fx-background-color: #1F1F1F;
                     -fx-background-radius: 18;
                     -fx-border-radius: 18;
                     -fx-border-color: #D4AF37;
                     -fx-border-width: 2;
                 ">

            <ImageView
                    fx:id="imgItem"
                    preserveRatio="true"/>

            <!-- PREVIOUS -->
            <Button
                    onAction="#showPreviousImage"
                    prefHeight="40"
                    prefWidth="40"
                    text="❮"
                    StackPane.alignment="CENTER_LEFT"
                    style="
                        -fx-background-color: rgba(0,0,0,0.5);
                        -fx-text-fill: white;
                        -fx-background-radius: 50;
                        -fx-cursor: hand;
                    ">
               <StackPane.margin>
                  <Insets left="10"/>
               </StackPane.margin>
            </Button>

            <!-- NEXT -->
            <Button
                    onAction="#showNextImage"
                    prefHeight="40"
                    prefWidth="40"
                    text="❯"
                    StackPane.alignment="CENTER_RIGHT"
                    style="
                        -fx-background-color: rgba(0,0,0,0.5);
                        -fx-text-fill: white;
                        -fx-background-radius: 50;
                        -fx-cursor: hand;
                    ">
               <StackPane.margin>
                  <Insets right="10"/>
               </StackPane.margin>
            </Button>

         </StackPane>
      </VBox>
   </left>

   <!-- ================= CENTER ================= -->
   <center>
      <VBox alignment="CENTER">

         <Region VBox.vgrow="ALWAYS"/>

         <VBox spacing="22">

            <!-- DESCRIPTION -->
            <VBox spacing="12">

               <Label
                       text="DESCRIPTION"
                       textFill="#D4AF37">
                  <font>
                     <Font name="Arial Bold" size="18"/>
                  </font>
               </Label>

               <TextArea
                       fx:id="txtDescription"
                       editable="false"
                       prefWidth="700"
                       maxWidth="Infinity"
                       minHeight="180"
                       prefHeight="220"
                       wrapText="true"
                       VBox.vgrow="ALWAYS"
                       style="
                           -fx-control-inner-background: #1F1F1F;
                           -fx-text-fill: white;
                           -fx-font-size: 14px;
                           -fx-background-radius: 12;
                           -fx-border-radius: 12;
                           -fx-border-color: #333333;
                           -fx-background-insets: 0;
                       "/>

            </VBox>

            <padding>
               <Insets
                       top="20"
                       right="40"
                       bottom="20"
                       left="40"/>
            </padding>

            <!-- AUCTION INFO -->
            <VBox
                    prefWidth="700"
                    maxWidth="Infinity"
                    style="
                        -fx-background-color: #1A1A1A;
                        -fx-background-radius: 16;
                        -fx-border-radius: 16;
                        -fx-border-color: #2C2C2C;
                    ">

               <padding>
                  <Insets
                          top="20"
                          right="40"
                          bottom="20"
                          left="40"/>
               </padding>

               <!-- TITLE -->
               <Label
                       text="AUCTION INFORMATION"
                       textFill="#D4AF37">
                  <font>
                     <Font name="Arial Bold" size="18"/>
                  </font>
                  <VBox.margin>
                     <Insets bottom="12"/>
                  </VBox.margin>
               </Label>

               <!-- ALL INFO ROWS — same font, same spacing -->
               <VBox spacing="14" alignment="CENTER_LEFT">

                  <!-- STATUS BADGE -->
                  <Label
                          fx:id="lblStatusBadge"
                          text="Status: Leading"
                          textFill="white">
                     <font>
                        <Font size="17"/>
                     </font>
                  </Label>

                  <!-- PAYMENT STATUS -->
                  <Label
                          fx:id="lblPaymentStatus"
                          text="Status: Unpaid"
                          visible="false"
                          managed="false">
                     <font>
                        <Font size="16"/>
                     </font>
                  </Label>

                  <!-- CURRENT PRICE -->
                  <Label
                          fx:id="lblCurrentPrice"
                          text="Current Price:"
                          textFill="WHITE">
                     <font>
                        <Font size="16"/>
                     </font>
                  </Label>

                  <!-- MIN INCREMENT -->
                  <Label
                          fx:id="lblStep"
                          text="Min Increment:"
                          textFill="WHITE">
                     <font>
                        <Font size="16"/>
                     </font>
                  </Label>

                  <!-- START TIME -->
                  <Label
                          fx:id="lblStart"
                          text="Start Time:"
                          textFill="WHITE">
                     <font>
                        <Font size="16"/>
                     </font>
                  </Label>

                  <!-- END TIME -->
                  <Label
                          fx:id="lblEnd"
                          text="End Time:"
                          textFill="WHITE">
                     <font>
                        <Font size="16"/>
                     </font>
                  </Label>

               </VBox>

            </VBox>

         </VBox>

         <Region VBox.vgrow="ALWAYS"/>

      </VBox>
   </center>

   <!-- ================= BOTTOM ================= -->
   <bottom>
      <HBox
              alignment="CENTER"
              minHeight="90"
              prefHeight="90"
              spacing="20"
              style="
                  -fx-background-color: #1A1A1A;
                  -fx-border-color: #2C2C2C;
                  -fx-border-width: 2 0 0 0;
              ">

         <padding>
            <Insets
                    left="30"
                    right="30"/>
         </padding>

         <!-- BACK -->
         <Button
                 onMouseClicked="#handleBack"
                 prefHeight="45"
                 minWidth="140"
                 text="BACK"
                 style="
                     -fx-background-color: transparent;
                     -fx-text-fill: #D4AF37;
                     -fx-border-color: #D4AF37;
                     -fx-border-width: 2;
                     -fx-border-radius: 12;
                     -fx-background-radius: 12;
                     -fx-cursor: hand;
                 ">
            <font>
               <Font
                       name="Berlin Sans FB Demi Bold"
                       size="15"/>
            </font>
         </Button>

         <Region HBox.hgrow="ALWAYS"/>

         <!-- FAVOURITE -->
         <Button
                 fx:id="btnFavourite"
                 onAction="#handleAddToFavourite"
                 prefHeight="45"
                 prefWidth="210"
                 text="Add to favourite"
                 style="
                     -fx-background-color: transparent;
                     -fx-text-fill: #D4AF37;
                     -fx-border-color: #D4AF37;
                     -fx-border-width: 2;
                     -fx-border-radius: 12;
                     -fx-background-radius: 12;
                     -fx-cursor: hand;
                 ">
            <font>
               <Font
                       name="Berlin Sans FB Demi Bold"
                       size="15"/>
            </font>
         </Button>

         <!-- JOIN -->
         <Button
                 fx:id="btnJoinAuction"
                 onAction="#handleJoinAuction"
                 prefHeight="45"
                 minWidth="180"
                 text="JOIN AUCTION"
                 style="
                     -fx-background-color: #D4AF37;
                     -fx-text-fill: black;
                     -fx-font-weight: bold;
                     -fx-background-radius: 12;
                     -fx-font-size: 15px;
                     -fx-cursor: hand;
                 ">
            <font>
               <Font
                       name="Berlin Sans FB Demi Bold"
                       size="15"/>
            </font>
         </Button>

      </HBox>
   </bottom>

</BorderPane>
