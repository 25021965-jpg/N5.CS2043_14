<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #121212;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.ItemViewController">

   <!-- TOP -->
   <top>

      <VBox spacing="10.0" style="-fx-background-color: #1a1a1a;                      -fx-border-color: #d4af37;                      -fx-border-width: 0 0 2 0;">

         <padding>
            <Insets bottom="20.0" left="30.0" top="20.0" />
         </padding>

         <children>

            <Label fx:id="lblName" text="Item Information" textFill="#d4af37">

               <font>
                  <Font name="Berlin Sans FB Demi Bold" size="34.0" />
               </font>

            </Label>

         </children>

      </VBox>

   </top>

   <!-- LEFT IMAGE -->
   <left>

      <VBox alignment="TOP_CENTER" prefWidth="420.0" spacing="20.0">

         <padding>
            <Insets left="25.0" right="10.0" top="30.0" />
         </padding>

         <children>

            <StackPane prefHeight="340.0" prefWidth="380.0" style="-fx-background-color: #1f1f1f; -fx-background-radius: 18; -fx-border-radius: 18; -fx-border-color: #d4af37; -fx-border-width: 2;">
               <children>
                  <ImageView fx:id="imgItem" fitHeight="340.0" fitWidth="380.0" preserveRatio="false" />

                  <Button mnemonicParsing="false" onAction="#showPreviousImage" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: rgba(0,0,0,0.5); -fx-text-fill: white; -fx-background-radius: 50; -fx-cursor: hand;" text="❮" StackPane.alignment="CENTER_LEFT">
                     <StackPane.margin><Insets left="10.0" /></StackPane.margin>
                  </Button>

                  <Button mnemonicParsing="false" onAction="#showNextImage" prefHeight="40.0" prefWidth="40.0" style="-fx-background-color: rgba(0,0,0,0.5); -fx-text-fill: white; -fx-background-radius: 50; -fx-cursor: hand;" text="❯" StackPane.alignment="CENTER_RIGHT">
                     <StackPane.margin><Insets right="10.0" /></StackPane.margin>
                  </Button>
               </children>
            </StackPane>

         </children>

      </VBox>

   </left>

   <!-- CENTER CONTENT -->
   <center>

      <VBox spacing="22.0">

         <padding>
            <Insets left="15.0" right="30.0" top="30.0" />
         </padding>

         <children>

            <!-- DESCRIPTION -->
            <VBox spacing="10.0">

               <children>

                  <Label text="DESCRIPTION" textFill="#d4af37">

                     <font>
                        <Font name="Arial Bold" size="18.0" />
                     </font>

                  </Label>

                  <TextArea fx:id="txtDescription" editable="false" prefHeight="180.0" style="                                   -fx-control-inner-background: #1f1f1f;                                   -fx-text-fill: white;                                   -fx-font-size: 14px;                                   -fx-background-radius: 12;                                   -fx-border-radius: 12;                                   -fx-border-color: #333333;                                   -fx-background-insets: 0;                                   " wrapText="true" />

               </children>

            </VBox>

            <!-- INFO CARD -->
            <VBox prefWidth="400.0" spacing="18.0" style="                       -fx-background-color: #1a1a1a;                       -fx-background-radius: 16;                       -fx-border-radius: 16;                       -fx-border-color: #2c2c2c;                       ">

               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>

               <children>

                  <Label text="AUCTION INFORMATION" textFill="#d4af37">

                     <font>
                        <Font name="Arial Bold" size="18.0" />
                     </font>

                  </Label>

                  <Label fx:id="lblCurrentPrice" text="Current Price: " textFill="WHITE">

                     <font>
                        <Font size="16.0" />
                     </font>

                  </Label>

                  <Label fx:id="lblStep" text="Min Increment: " textFill="WHITE">

                     <font>
                        <Font size="16.0" />
                     </font>

                  </Label>

                  <Label fx:id="lblStart" text="Start Time: " textFill="WHITE">

                     <font>
                        <Font size="16.0" />
                     </font>

                  </Label>

                  <Label fx:id="lblEnd" text="End Time: " textFill="WHITE">

                     <font>
                        <Font size="16.0" />
                     </font>

                  </Label>

               </children>

            </VBox>

         </children>

      </VBox>

   </center>

   <!-- BOTTOM -->
   <bottom>

      <HBox alignment="CENTER" prefHeight="90.0" spacing="20.0" style="               -fx-background-color: #1a1a1a;               -fx-border-color: #2c2c2c;               -fx-border-width: 2 0 0 0;               ">

         <padding>
            <Insets left="30.0" right="30.0" />
         </padding>

         <children>

            <Button mnemonicParsing="false" onAction="#handleBack" prefHeight="45.0" prefWidth="140.0" style="                         -fx-background-color: transparent;                         -fx-text-fill: #d4af37;                         -fx-border-color: #d4af37;                         -fx-border-width: 2;                         -fx-border-radius: 12;                         -fx-background-radius: 12;                         -fx-font-weight: bold;                         -fx-cursor: hand;                         " text="BACK">

               <font>
                  <Font name="Berlin Sans FB Demi Bold" size="15.0" />
               </font>

            </Button>

            <Region HBox.hgrow="ALWAYS" />
            <Button layoutX="700.0" layoutY="33.0" mnemonicParsing="false" onAction="#handleAddToFavourite" prefHeight="45.0" prefWidth="178.0" style="                         -fx-background-color: #d4af37;                         -fx-text-fill: black;                         -fx-font-weight: bold;                         -fx-background-radius: 12;                         -fx-font-size: 15px;                         -fx-cursor: hand;                         " text="ADD TO FAVOURITE">
               <font>
                  <Font name="Berlin Sans FB Demi Bold" size="15.0" />
               </font>
            </Button>
            <Button layoutX="700.0" layoutY="33.0" mnemonicParsing="false" onAction="#handleJoinAuction" prefHeight="45.0" prefWidth="180.0" style="                         -fx-background-color: #d4af37;                         -fx-text-fill: black;                         -fx-font-weight: bold;                         -fx-background-radius: 12;                         -fx-font-size: 15px;                         -fx-cursor: hand;                         " text="JOIN AUCTION">
               <font>
                  <Font name="Berlin Sans FB Demi Bold" size="15.0" />
               </font>
            </Button>

         </children>

      </HBox>

   </bottom>

</BorderPane>
