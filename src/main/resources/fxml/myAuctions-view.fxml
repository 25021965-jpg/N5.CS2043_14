<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<AnchorPane
        prefHeight="720.0"
        prefWidth="1080.0"

        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"

        fx:controller="client.controller.MyAuctionsController"

        style="
            -fx-background-color: #F8FAFC;
            -fx-border-color: #D4AF37;
            -fx-border-width: 6;
        ">

    <fx:include
            source="sidebar-view.fxml"

            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"/>

    <!-- PAGE TITLE -->
    <Label
            layoutX="290"
            layoutY="35"

            text="My Auctions"

            style="
                -fx-font-size: 32px;
                -fx-font-weight: bold;
                -fx-text-fill: #0F172A;
            "/>

    <!-- FILTER -->
    <HBox
            layoutX="290"
            layoutY="100"

            spacing="15"
            alignment="CENTER_LEFT">

        <Label
                text="Status"

                style="
                    -fx-font-size: 16px;
                    -fx-font-weight: bold;
                    -fx-text-fill: #334155;
                "/>

        <ComboBox
                fx:id="statusFilterComboBox"

                prefHeight="40"
                prefWidth="220"

                promptText="Select Status"

                style="
                    -fx-background-radius: 8;
                    -fx-border-radius: 8;
                    -fx-border-color: #D4AF37;
                "/>

        <Label
                text="Category"

                style="
                    -fx-font-size: 16px;
                    -fx-font-weight: bold;
                    -fx-text-fill: #334155;
                "/>

        <ComboBox
                fx:id="categoryFilterComboBox"

                prefHeight="40"
                prefWidth="220"

                promptText="Select Category"

                style="
                    -fx-background-radius: 8;
                    -fx-border-radius: 8;
                    -fx-border-color: #D4AF37;
                "/>

    </HBox>

    <!-- AUCTION LIST -->
    <ScrollPane
            layoutX="290"
            layoutY="160"

            prefHeight="520"
            prefWidth="760"

            fitToWidth="true"

            style="
                -fx-background-color: transparent;
                -fx-background: transparent;
            ">

        <VBox
                prefWidth="730"
                spacing="20"

                style="-fx-padding: 10;">

            <GridPane
                    fx:id="itemGrid"
                    hgap="20"
                    vgap="20"/>

        </VBox>

    </ScrollPane>

</AnchorPane>