<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.GridPane?>
<AnchorPane
        prefHeight="720.0"
        prefWidth="1080.0"

        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"

        fx:controller="client.controller.MyAuctionsController"

        style="
            -fx-background-color: #F8FAFC;
            -fx-border-color: #D4AF37;
            -fx-border-width: 6;
        ">

    <!-- LEFT MENU -->
    <VBox
            prefWidth="250"
            spacing="18"

            AnchorPane.topAnchor="0"
            AnchorPane.bottomAnchor="0"
            AnchorPane.leftAnchor="0"

            style="
                -fx-background-color: black;
                -fx-border-color: #D4AF37;
                -fx-border-width: 0 3 0 0;
                -fx-padding: 30 20 20 20;
            ">

        <!-- TITLE -->
        <VBox alignment="CENTER" spacing="6">

            <Label
                    text="Auction System"

                    style="
                        -fx-text-fill: white;
                        -fx-font-size: 26px;
                        -fx-font-weight: bold;
                    "/>

            <Label
                    text="USER PANEL"

                    style="
                        -fx-text-fill: #94A3B8;
                        -fx-font-size: 13px;
                    "/>

        </VBox>

        <Separator style="-fx-background-color: #334155;"/>

        <!-- MENU BUTTONS -->
        <Button
                fx:id="infoBtn"
                text="Profile"
                prefHeight="45"
                prefWidth="210"
                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>


        <Button
                fx:id="historyBtn"
                text="Auction History"
                prefHeight="45"
                prefWidth="210"
                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>

        <Button
                fx:id="createdAuctionBtn"
                text="My Auctions"
                prefHeight="45"
                prefWidth="210"

                style="
                    -fx-background-color: #475569;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>

        <Button
                fx:id="favoriteBtn"
                text="Favourite"
                prefHeight="45"
                prefWidth="210"
                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>

        <Button
                fx:id="balanceBtn"
                text="Account Balance"
                prefHeight="45"
                prefWidth="210"
                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>

        <!-- LOGOUT -->
        <Button
                fx:id="logoutBtn"
                text="Log Out"
                prefHeight="48"
                prefWidth="210"
                style="
                    -fx-background-color: #D4AF37;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>


        <!-- DELETE -->
        <Button
                fx:id="deleteAccountBtn"
                text="DELETE ACCOUNT"
                prefHeight="48"
                prefWidth="210"
                style="
                    -fx-background-color: #EF4444;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- BACK -->
        <Button
                fx:id="backHomeBtn"
                text="← Back To Home"
                prefHeight="48"
                prefWidth="210"
                style="
                    -fx-background-color: #2563EB;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>

    </VBox>

    <!-- PAGE TITLE -->
    <Label
            layoutX="290"
            layoutY="35"

            text="My Auctions"

            style="
                -fx-font-size: 32px;
                -fx-font-weight: bold;
                -fx-text-fill: #0F172A;
            "/>

    <!-- FILTER -->
    <HBox
            layoutX="290"
            layoutY="100"

            spacing="15"
            alignment="CENTER_LEFT">

        <Label
                text="Status"

                style="
                    -fx-font-size: 16px;
                    -fx-font-weight: bold;
                    -fx-text-fill: #334155;
                "/>

        <ComboBox
                fx:id="statusFilterComboBox"

                prefHeight="40"
                prefWidth="220"

                promptText="Select Status"

                style="
                    -fx-background-radius: 8;
                    -fx-border-radius: 8;
                    -fx-border-color: #D4AF37;
                "/>

        <Label
                text="Category"

                style="
                    -fx-font-size: 16px;
                    -fx-font-weight: bold;
                    -fx-text-fill: #334155;
                "/>

        <ComboBox
                fx:id="categoryFilterComboBox"

                prefHeight="40"
                prefWidth="220"

                promptText="Select Category"

                style="
                    -fx-background-radius: 8;
                    -fx-border-radius: 8;
                    -fx-border-color: #D4AF37;
                "/>

    </HBox>

    <!-- AUCTION LIST -->
    <ScrollPane
            layoutX="290"
            layoutY="160"

            prefHeight="520"
            prefWidth="760"

            fitToWidth="true"

            style="
                -fx-background-color: transparent;
                -fx-background: transparent;
            ">

        <VBox
                prefWidth="730"
                spacing="20"

                style="-fx-padding: 10;">

            <GridPane
                    fx:id="itemGrid"
                    hgap="20"
                    vgap="20"/>

        </VBox>

    </ScrollPane>

</AnchorPane>