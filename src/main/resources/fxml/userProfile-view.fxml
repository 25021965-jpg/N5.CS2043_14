<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane
        prefHeight="720.0"
        prefWidth="1080.0"
        style="
            -fx-background-color: #F8FAFC;
            -fx-border-color: #D4AF37;
            -fx-border-width: 6;
        "
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="client.controller.ProfileController">

    <!-- ================================================= -->
    <!-- LEFT MENU -->
    <!-- ================================================= -->

    <VBox
            prefWidth="250.0"
            spacing="18"
            style="
                -fx-background-color: #000000;
                -fx-border-color: #D4AF37;
                -fx-border-width: 0 3 0 0;
                -fx-padding: 30 20 20 20;
            "
            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0">

        <!-- TITLE -->

        <VBox alignment="CENTER" spacing="6">

            <Label
                    text="Auction System"
                    style="
                        -fx-text-fill: white;
                        -fx-font-size: 26px;
                        -fx-font-weight: bold;
                    ">
                <font>
                    <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
                </font>
            </Label>

            <Label
                    text="USER PANEL"
                    style="
                        -fx-text-fill: #94A3B8;
                        -fx-font-size: 13px;
                    "/>

        </VBox>

        <Separator style="-fx-background-color: #334155;"/>

        <!-- MENU BUTTONS -->

        <Button
                fx:id="infoBtn"
                text="Profile"
                prefHeight="45"
                prefWidth="210"
                style="
                    -fx-background-color: #475569;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>

        <Button
                fx:id="historyBtn"
                text="Auction History"
                prefHeight="45"
                prefWidth="210"
                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>

        <Button
                fx:id="createdAuctionBtn"
                text="My Auctions"
                prefHeight="45"
                prefWidth="210"
                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>

        <Button
                fx:id="favoriteBtn"
                text="Favourite"
                prefHeight="45"
                prefWidth="210"
                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>

        <Button
                fx:id="balanceBtn"
                text="Account Balance"
                prefHeight="45"
                prefWidth="210"
                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>

        <Button
                fx:id="logoutBtn"
                text="Log Out"
                prefHeight="48"
                prefWidth="210"
                style="
                    -fx-background-color: #D4AF37;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>

        <Button
                fx:id="deleteAccountBtn"
                text="DELETE ACCOUNT"
                prefHeight="48"
                prefWidth="210"
                style="
                    -fx-background-color: #EF4444;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>

        <Region VBox.vgrow="ALWAYS"/>

        <Button
                fx:id="backHomeBtn"
                text="← Back To Home"
                onAction="#handleBackHome"
                prefHeight="48"
                prefWidth="210"
                style="
                    -fx-background-color: #2563EB;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Button>

    </VBox>

    <!-- ================================================= -->
    <!-- RIGHT CONTENT -->
    <!-- ================================================= -->

    <VBox layoutX="320" layoutY="90" spacing="25">

        <!-- TITLE -->

        <Label
                text="Information"
                style="
                    -fx-font-size: 32px;
                    -fx-font-weight: bold;
                    -fx-text-fill: #0F172A;
                ">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
            </font>
        </Label>

        <!-- ================================================= -->
        <!-- INFO GRID -->
        <!-- ================================================= -->

        <GridPane hgap="20" vgap="18">

            <columnConstraints>
                <ColumnConstraints/>
                <ColumnConstraints/>
            </columnConstraints>

            <rowConstraints>
                <RowConstraints/>
                <RowConstraints/>
                <RowConstraints/>
            </rowConstraints>

            <!-- FULL NAME -->

            <Label
                    text="Full Name"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="0"
                    style="
                        -fx-font-size: 15px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #334155;
                    ">
                <font>
                    <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
                </font>
            </Label>

            <HBox
                    prefHeight="50"
                    prefWidth="520"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="0"
                    style="
                        -fx-background-color: white;
                        -fx-border-color: #D4AF37;
                        -fx-border-width: 2;
                        -fx-border-radius: 8;
                        -fx-background-radius: 8;
                        -fx-alignment: CENTER-LEFT;
                        -fx-padding: 0 15 0 15;
                    ">

                <Label
                        fx:id="fullNameLabel"
                        text="Nguyen Van A"
                        style="
                            -fx-font-size: 15px;
                            -fx-text-fill: #94A3B8;
                        "/>

            </HBox>

            <!-- USERNAME -->

            <Label
                    text="Username"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="1"
                    style="
                        -fx-font-size: 15px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #334155;
                    ">
                <font>
                    <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
                </font>
            </Label>

            <HBox
                    prefHeight="50"
                    prefWidth="520"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="1"
                    style="
                        -fx-background-color: white;
                        -fx-border-color: #D4AF37;
                        -fx-border-width: 2;
                        -fx-border-radius: 8;
                        -fx-background-radius: 8;
                        -fx-alignment: CENTER-LEFT;
                        -fx-padding: 0 15 0 15;
                    ">

                <Label
                        fx:id="usernameLabel"
                        text="user123"
                        style="
                            -fx-font-size: 15px;
                            -fx-text-fill: #94A3B8;
                        "/>

                <Label
                        text="   |   "
                        style="
                            -fx-text-fill: #CBD5E1;
                            -fx-font-size: 15px;
                        "/>

                <Label
                        fx:id="dobLabel"
                        text="01/01/2000"
                        style="
                            -fx-font-size: 15px;
                            -fx-text-fill: #94A3B8;
                        "/>

            </HBox>

            <!-- EMAIL -->

            <Label
                    text="Email"
                    GridPane.columnIndex="0"
                    GridPane.rowIndex="2"
                    style="
                        -fx-font-size: 15px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #334155;
                    ">
                <font>
                    <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
                </font>
            </Label>

            <HBox
                    prefHeight="50"
                    prefWidth="520"
                    GridPane.columnIndex="1"
                    GridPane.rowIndex="2"
                    style="
                        -fx-background-color: white;
                        -fx-border-color: #D4AF37;
                        -fx-border-width: 2;
                        -fx-border-radius: 8;
                        -fx-background-radius: 8;
                        -fx-alignment: CENTER-LEFT;
                        -fx-padding: 0 15 0 15;
                    ">

                <Label
                        fx:id="emailLabel"
                        text="example@gmail.com"
                        style="
                            -fx-font-size: 15px;
                            -fx-text-fill: #94A3B8;
                        "/>

            </HBox>

        </GridPane>

        <!-- ================================================= -->
        <!-- RESET PASSWORD -->
        <!-- ================================================= -->

        <VBox spacing="12">

            <Label
                    text="Reset Password"
                    style="
                        -fx-font-size: 18px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #334155;
                    ">
                <font>
                    <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
                </font>
            </Label>

            <!-- OLD PASSWORD -->

            <HBox
                    alignment="CENTER_LEFT"
                    prefHeight="45"
                    prefWidth="420"
                    spacing="5"
                    style="
                        -fx-background-color: white;
                        -fx-border-color: #D4AF37;
                        -fx-border-width: 2;
                        -fx-border-radius: 8;
                        -fx-background-radius: 8;
                        -fx-padding: 0 8 0 8;
                    ">

                <PasswordField
                        fx:id="oldPasswordField"
                        prefWidth="340"
                        promptText="Old Password"
                        style="
                            -fx-background-color: transparent;
                            -fx-border-color: transparent;
                        "/>

                <TextField
                        fx:id="oldPasswordTextField"
                        visible="false"
                        managed="false"
                        prefWidth="340"
                        promptText="Old Password"
                        style="
                            -fx-background-color: transparent;
                            -fx-border-color: transparent;
                        "/>

                <Button
                        fx:id="toggleOldBtn"
                        text="👁"
                        prefWidth="40"
                        style="
                            -fx-background-color: transparent;
                            -fx-font-size: 16px;
                            -fx-cursor: hand;
                        "/>

            </HBox>

            <!-- NEW PASSWORD -->

            <HBox
                    alignment="CENTER_LEFT"
                    prefHeight="45"
                    prefWidth="420"
                    spacing="5"
                    style="
                        -fx-background-color: white;
                        -fx-border-color: #D4AF37;
                        -fx-border-width: 2;
                        -fx-border-radius: 8;
                        -fx-background-radius: 8;
                        -fx-padding: 0 8 0 8;
                    ">

                <PasswordField
                        fx:id="newPasswordField"
                        prefWidth="340"
                        promptText="New Password"
                        style="
                            -fx-background-color: transparent;
                            -fx-border-color: transparent;
                        "/>

                <TextField
                        fx:id="newPasswordTextField"
                        visible="false"
                        managed="false"
                        prefWidth="340"
                        promptText="New Password"
                        style="
                            -fx-background-color: transparent;
                            -fx-border-color: transparent;
                        "/>

                <Button
                        fx:id="toggleNewBtn"
                        text="👁"
                        prefWidth="40"
                        style="
                            -fx-background-color: transparent;
                            -fx-font-size: 16px;
                            -fx-cursor: hand;
                        "/>

            </HBox>

            <!-- VERIFY PASSWORD -->

            <HBox
                    alignment="CENTER_LEFT"
                    prefHeight="45"
                    prefWidth="420"
                    spacing="5"
                    style="
                        -fx-background-color: white;
                        -fx-border-color: #D4AF37;
                        -fx-border-width: 2;
                        -fx-border-radius: 8;
                        -fx-background-radius: 8;
                        -fx-padding: 0 8 0 8;
                    ">

                <PasswordField
                        fx:id="verifyNewPasswordField"
                        prefWidth="340"
                        promptText="Confirm Password"
                        style="
                            -fx-background-color: transparent;
                            -fx-border-color: transparent;
                        "/>

                <TextField
                        fx:id="verifyNewPasswordTextField"
                        visible="false"
                        managed="false"
                        prefWidth="340"
                        promptText="Confirm Password"
                        style="
                            -fx-background-color: transparent;
                            -fx-border-color: transparent;
                        "/>

                <Button
                        fx:id="toggleVerifyBtn"
                        text="👁"
                        prefWidth="40"
                        style="
                            -fx-background-color: transparent;
                            -fx-font-size: 16px;
                            -fx-cursor: hand;
                        "/>

            </HBox>

        </VBox>

    </VBox>

    <!-- RESET BUTTON -->

    <Button
            layoutX="789.0"
            layoutY="582.0"
            prefHeight="31.0"
            prefWidth="143.0"
            text="Reset Password"
            onAction="#resetPassword"
            style="
                -fx-background-color: #D4AF37;
                -fx-text-fill: white;
                -fx-font-size: 15px;
                -fx-font-weight: bold;
                -fx-background-radius: 8;
            ">
        <font>
            <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
        </font>
    </Button>

</AnchorPane>