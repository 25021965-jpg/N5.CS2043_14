<HBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.RegisterController">
   <children>
      <VBox alignment="CENTER" prefHeight="600.0" prefWidth="334.0" style="-fx-background-color: #B71C1C;" HBox.hgrow="ALWAYS">
         <children>
            <ImageView fitHeight="417.0" fitWidth="408.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../image/register.jpg" />
               </image>
            </ImageView>
         </children></VBox>
      <VBox alignment="CENTER" prefHeight="600.0" prefWidth="383.0" spacing="10.0" style="-fx-background-color: #121212;" HBox.hgrow="ALWAYS">
         <children>
            <Label text="CREATE ACCOUNT">
               <font>
                  <Font name="Berlin Sans FB Demi Bold" size="41.0" />
               </font>
               <textFill>
                  <LinearGradient cycleMethod="REFLECT" endX="1.0" endY="0.5253164194807222" startX="1.0">
                     <stops>
                        <Stop>
                           <color>
                              <Color />
                           </color>
                        </Stop>
                        <Stop offset="1.0">
                           <color>
                              <Color red="1.0" green="1.0" blue="1.0" />
                           </color>
                        </Stop>
                     </stops>
                  </LinearGradient>
               </textFill>
            </Label>
            <TextField fx:id="fullNameField" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="31.0" prefWidth="309.0" promptText="Full name ">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
