            <TextField fx:id="emailField" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="34.0" prefWidth="310.0" promptText="Email" />
            <PasswordField fx:id="passwordField" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="39.0" prefWidth="310.0" promptText="Password" />
            <PasswordField fx:id="verifyPasswordField" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="39.0" prefWidth="311.0" promptText="Verify Password" />
            <Button mnemonicParsing="false" onAction="#handleCreate" prefHeight="37.0" prefWidth="312.0" style="-fx-background-color: #2C2C2C;" text="CREATE" textFill="WHITE">
