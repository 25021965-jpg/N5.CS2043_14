<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<HBox
        prefWidth="1100.0"
        prefHeight="850"
        minWidth="-Infinity"
        minHeight="-Infinity"
        maxWidth="-Infinity"
        maxHeight="-Infinity"
        style="
        -fx-background-color: #121212;
        -fx-border-color: #D4AF37;
        -fx-border-width: 6;"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="client.controller.LoginController">

   <!-- LEFT SIDE -->
   <VBox
           alignment="CENTER"
           prefWidth="444.0"
           prefHeight="600.0"
           HBox.hgrow="ALWAYS">

      <Label
              text="LOG IN"
              prefWidth="139.0"
              prefHeight="46.0"
              style="-fx-text-fill: white; -fx-font-size: 41px; -fx-font-weight: bold;">

         <font>
            <Font
                    name="Berlin Sans FB Demi Bold"
                    size="41.0"/>
         </font>

      </Label>

      <TextField
              fx:id="userField"
              prefWidth="332.0"
              prefHeight="46.0"
              minWidth="-Infinity"
              minHeight="-Infinity"
              maxWidth="-Infinity"
              maxHeight="-Infinity"
              promptText="Username"
              style="-fx-background-color: #D4AF37, white;
                         -fx-background-insets: 0, 2;
                         -fx-background-radius: 8, 8;
                         -fx-padding: 8;">

         <VBox.margin>
            <Insets
                    top="20.0"
                    bottom="20.0"/>
         </VBox.margin>

      </TextField>

      <PasswordField
              fx:id="passField"
              prefWidth="331.0"
              prefHeight="45.0"
              minWidth="-Infinity"
              minHeight="-Infinity"
              maxWidth="-Infinity"
              maxHeight="-Infinity"
              promptText="Password"
              style="-fx-background-color: white;
                         -fx-border-color: #D4AF37;
                         -fx-border-width: 2;
                         -fx-border-radius: 8;
                         -fx-background-radius: 8;
                         -fx-padding: 8;">

         <VBox.margin>
            <Insets bottom="20.0"/>
         </VBox.margin>

      </PasswordField>

      <Button
              fx:id="loginBtn"
              text="Log in"
              onAction="#handleLogin"
              mnemonicParsing="false"
              prefWidth="329.0"
              prefHeight="41.0"
              style="-fx-background-color: #D4AF37;
               -fx-text-fill: black;
               -fx-cursor: hand;
               -fx-padding: 10;">
         <font>
            <Font name="Berlin Sans FB Demi Bold"
                  size="24.0"/>
         </font>

      </Button>

      <Hyperlink
              fx:id="forgotPasswordLink"
              text="Forgot password?"
              onAction="#goToForgotPass"
              onMouseEntered="#underlineLink"
              onMouseExited="#removeUnderlineLink"
              style="-fx-text-fill: #D4AF37;
               -fx-border-color: transparent;">

         <VBox.margin>
            <Insets top="10.0" bottom="5.0"/>
         </VBox.margin>

         <font>
            <Font
                    name="Berlin Sans FB Demi Bold"
                    size="18.0"/>
         </font>

      </Hyperlink>

      <HBox
              alignment="CENTER"
              prefWidth="200.0"
              prefHeight="100.0">

         <Label
                 text="Don't have account?"
                 style="-fx-text-fill: white;
                              -fx-font-size: 18px;
                              -fx-font-weight: bold;">

            <font>
               <Font
                       name="Berlin Sans FB Demi Bold"
                       size="18.0"/>
            </font>

         </Label>

         <Hyperlink
                 text="Register"
                 onAction="#goToRegister"
                 style="-fx-text-fill: #D4AF37;
                              -fx-font-size: 19px;
                              -fx-font-weight: bold;">

            <font>
               <Font
                       name="Berlin Sans FB Demi Bold"
                       size="19.0"/>
            </font>

         </Hyperlink>

      </HBox>

   </VBox>

   <!-- RIGHT SIDE -->
   <VBox
           alignment="CENTER"
           prefWidth="408.0"
           prefHeight="600.0"
           style="-fx-background-color: #FFFFFF;"
           HBox.hgrow="ALWAYS">

      <ImageView
              fitWidth="397.0"
              fitHeight="391.0"
              pickOnBounds="true"
              preserveRatio="true">

         <Image url="@../image/login.jpg"/>
      </ImageView>

   </VBox>

</HBox>