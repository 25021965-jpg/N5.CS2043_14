<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.ProfileController">

    <!-- LEFT MENU -->
    <VBox layoutX="0.0" layoutY="0.0"
          prefWidth="250.0"
          prefHeight="720.0"
          spacing="15"
          style="-fx-background-color: #1E293B;">

        <padding>
            <Insets top="30" left="20" right="20" bottom="20"/>
        </padding>

        <!-- TITLE -->
        <Label text="USER PANEL"
               style="-fx-text-fill: white;
                      -fx-font-size: 24px;
                      -fx-font-weight: bold;"/>

        <Separator/>

        <!-- MENU BUTTONS -->
        <Button fx:id="historyBtn"
                text="Lịch sử giao dịch"
                prefWidth="210"
                prefHeight="45"
                style="-fx-background-color: #334155;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;"/>

        <Button fx:id="createdAuctionBtn"
                text="Các giao dịch đã tạo"
                prefWidth="210"
                prefHeight="45"
                style="-fx-background-color: #334155;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;"/>

        <Button fx:id="favoriteBtn"
                text="Favourite Item"
                prefWidth="210"
                prefHeight="45"
                style="-fx-background-color: #334155;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;"/>

        <Button fx:id="logoutBtn"
                text="Log Out"
                prefWidth="210"
                prefHeight="45"
                style="-fx-background-color: #F59E0B;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;"/>

        <Button fx:id="deleteAccountBtn"
                text="Xóa tài khoản"
                prefWidth="210"
                prefHeight="45"
                style="-fx-background-color: #DC2626;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;"/>

        <!-- PUSH BUTTON DOWN -->
        <VBox prefHeight="250"/>

        <!-- BACK HOME -->
        <Button fx:id="backHomeBtn"
                text="← Back To Home"
                prefWidth="210"
                prefHeight="45"
                style="-fx-background-color: #2563EB;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;"/>
    </VBox>

    <!-- RIGHT CONTENT -->
    <VBox layoutX="300.0" layoutY="80.0"
          spacing="30">

        <!-- PAGE TITLE -->
        <Label text="Thông Tin Người Dùng"
               style="-fx-font-size: 32px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #0F172A;"/>

        <!-- FULL NAME -->
        <VBox spacing="10">
            <Label text="Họ và tên"
                   style="-fx-font-size: 16px;
                          -fx-font-weight: bold;"/>

            <HBox prefWidth="500"
                  prefHeight="50"
                  style="-fx-background-color: white;
                         -fx-border-color: #CBD5E1;
                         -fx-border-radius: 8;
                         -fx-background-radius: 8;
                         -fx-alignment: CENTER-LEFT;
                         -fx-padding: 0 15 0 15;">

                <Label fx:id="fullNameLabel"
                       text="Nguyễn Văn A"
                       style="-fx-font-size: 15px;"/>
            </HBox>
        </VBox>

        <!-- USERNAME -->
        <VBox spacing="10">
            <Label text="User Name"
                   style="-fx-font-size: 16px;
                          -fx-font-weight: bold;"/>

            <HBox prefWidth="500"
                  prefHeight="50"
                  style="-fx-background-color: white;
                         -fx-border-color: #CBD5E1;
                         -fx-border-radius: 8;
                         -fx-background-radius: 8;
                         -fx-alignment: CENTER-LEFT;
                         -fx-padding: 0 15 0 15;">

                <Label fx:id="usernameLabel"
                       text="user123"
                       style="-fx-font-size: 15px;"/>
            </HBox>
        </VBox>

        <!-- EMAIL -->
        <VBox spacing="10">
            <Label text="Email"
                   style="-fx-font-size: 16px;
                          -fx-font-weight: bold;"/>

            <HBox prefWidth="500"
                  prefHeight="50"
                  style="-fx-background-color: white;
                         -fx-border-color: #CBD5E1;
                         -fx-border-radius: 8;
                         -fx-background-radius: 8;
                         -fx-alignment: CENTER-LEFT;
                         -fx-padding: 0 15 0 15;">

                <Label fx:id="emailLabel"
                       text="example@gmail.com"
                       style="-fx-font-size: 15px;"/>
            </HBox>
        </VBox>

    </VBox>

</AnchorPane>