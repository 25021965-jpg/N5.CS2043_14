<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1300.0" style="-fx-background-color: linear-gradient(to bottom right,#0f0f0f,#1b1b1b);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.AdminController">
    <Label layoutX="455.0" layoutY="25.0" text="ADMIN DASHBOARD" textFill="#d4af37">
        <font><Font name="Berlin Sans FB Demi Bold" size="42.0" /></font>
    </Label>

    <HBox layoutX="35.0" layoutY="100.0" prefHeight="640.0" prefWidth="1230.0" spacing="25.0">
        <VBox prefHeight="640.0" prefWidth="260.0" spacing="18.0" style="-fx-background-color: #181818; -fx-background-radius: 25; -fx-border-radius: 25; -fx-border-color: #2d2d2d;">
            <padding><Insets bottom="30" left="20" right="20" top="30" /></padding>
            <VBox alignment="CENTER" spacing="10">
                <Label text="ADMIN" textFill="#d4af37"><font><Font size="28" /></font></Label>
                <Separator style="-fx-background-color: #d4af37;" />
            </VBox>

            <Button onAction="#handleManageUsers" prefHeight="50" style="-fx-background-color: #262626; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="Manage Users" maxWidth="Infinity"/>
            <Button onAction="#handleManageProducts" prefHeight="50" style="-fx-background-color: #262626; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="Manage Products" maxWidth="Infinity"/>
            <Button onAction="#handleAuctionHistory" prefHeight="50" style="-fx-background-color: #262626; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="Auction History" maxWidth="Infinity"/>
            <Button onAction="#handleManageAuctions" prefHeight="50" style="-fx-background-color: #262626; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="Manage Auctions" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS" />
            <Button onAction="#handleLogout" prefHeight="50" style="-fx-background-color: #d32f2f; -fx-text-fill: white; -fx-background-radius: 15; -fx-font-weight: bold; -fx-cursor: hand;" text="Logout" maxWidth="Infinity"/>
        </VBox>

        <VBox prefHeight="640.0" prefWidth="940.0" spacing="20.0" style="-fx-background-color: #181818; -fx-background-radius: 25; -fx-border-color: #2d2d2d;">
            <padding><Insets bottom="25" left="25" right="25" top="25" /></padding>
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Label text="USER MANAGEMENT" textFill="#d4af37"><font><Font name="Arial Bold" size="26" /></font></Label>
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="searchField" prefHeight="42" prefWidth="250" promptText="Search..." style="-fx-background-color: #262626; -fx-text-fill: white; -fx-background-radius: 14;" />
                <Button onAction="#handleReload" prefHeight="42" prefWidth="110" style="-fx-background-color: #d4af37; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 14;" text="Reload" />
            </HBox>

            <VBox prefHeight="500" spacing="15" style="-fx-background-color: #1f1f1f; -fx-background-radius: 20; -fx-padding: 20;">
                <TableView fx:id="userTable" prefHeight="450" style="-fx-background-color: #1f1f1f;">
                    <columns>
                        <TableColumn fx:id="userIdCol" prefWidth="100" text="ID" />
                        <TableColumn fx:id="usernameCol" prefWidth="220" text="USERNAME" />
                        <TableColumn fx:id="emailCol" prefWidth="300" text="EMAIL" />
                        <TableColumn fx:id="roleCol" prefWidth="180" text="ROLE" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="15">
                    <Button onAction="#handleDeleteUser" prefHeight="45" prefWidth="160" style="-fx-background-color: #ff5252; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 14;" text="DELETE USER" />
                    <Button prefHeight="45" prefWidth="160" style="-fx-background-color: #d4af37; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 14;" text="UPDATE USER" />
                </HBox>
            </VBox>
        </VBox>
    </HBox>
</AnchorPane>