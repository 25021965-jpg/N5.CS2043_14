<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1300.0" style="-fx-background-color: linear-gradient(to bottom right,#0f0f0f,#1b1b1b);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.AdminController">

    <!-- TITLE -->
    <Label layoutX="455.0" layoutY="25.0" text="ADMIN DASHBOARD" textFill="#d4af37">

        <font>
            <Font name="Berlin Sans FB Demi Bold" size="42.0" />
        </font>

    </Label>

    <!-- MAIN CONTAINER -->
    <HBox layoutX="35.0" layoutY="100.0" prefHeight="640.0" prefWidth="1230.0" spacing="25.0">

        <!-- LEFT MENU -->
        <VBox prefHeight="640.0" prefWidth="260.0" spacing="18.0" style="                 -fx-background-color: #181818;                 -fx-background-radius: 25;                 -fx-border-radius: 25;                 -fx-border-color: #2d2d2d;                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45),15,0,0,5);               ">

            <padding>
                <Insets bottom="30" left="20" right="20" top="30" />
            </padding>

            <!-- ADMIN INFO -->
            <VBox alignment="CENTER" spacing="10">

                <Label text="ADMIN" textFill="#d4af37">

                    <font>
                        <Font size="28" />
                    </font>

                </Label>

                <Separator style="-fx-background-color: #d4af37;" />

            </VBox>

            <!-- MENU BUTTONS -->

            <Button prefHeight="50" style="                         -fx-background-color: #262626;                         -fx-text-fill: white;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                         -fx-cursor: hand;                     " text="Manage Users" />

            <Button prefHeight="50" style="                         -fx-background-color: #262626;                         -fx-text-fill: white;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                         -fx-cursor: hand;                     " text="Manage Products" />

            <Button prefHeight="50" style="                         -fx-background-color: #262626;                         -fx-text-fill: white;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                         -fx-cursor: hand;                     " text="Auction History" />

            <Button prefHeight="50" style="                         -fx-background-color: #262626;                         -fx-text-fill: white;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                         -fx-cursor: hand;                     " text="Manage Auctions" />

            <Region VBox.vgrow="ALWAYS" />

            <!-- LOGOUT -->

            <Button onAction="#handleLogout" prefHeight="50" style="                         -fx-background-color: #d32f2f;                         -fx-text-fill: white;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                         -fx-cursor: hand;                     " text="Logout" />

        </VBox>

        <!-- RIGHT CONTENT -->
        <VBox prefHeight="640.0" prefWidth="940.0" spacing="20.0" style="                 -fx-background-color: #181818;                 -fx-background-radius: 25;                 -fx-border-radius: 25;                 -fx-border-color: #2d2d2d;                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45),15,0,0,5);               ">

            <padding>
                <Insets bottom="25" left="25" right="25" top="25" />
            </padding>

            <!-- TOP BAR -->
            <HBox alignment="CENTER_LEFT" spacing="15">

                <Label text="USER MANAGEMENT" textFill="#d4af37">

                    <font>
                        <Font name="Arial Bold" size="26" />
                    </font>

                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <TextField fx:id="searchField" prefHeight="42" prefWidth="250" promptText="Search..." style="                              -fx-background-color: #262626;                              -fx-text-fill: white;                              -fx-prompt-text-fill: #999;                              -fx-background-radius: 14;                              -fx-border-radius: 14;                              -fx-border-color: #3a3a3a;                            " />

                <Button onAction="#handleReload" prefHeight="42" prefWidth="110" style="                             -fx-background-color: #d4af37;                             -fx-text-fill: black;                             -fx-font-weight: bold;                             -fx-background-radius: 14;                             -fx-cursor: hand;                         " text="Reload" />

            </HBox>

            <!-- TABLE CARD -->
            <VBox prefHeight="500" spacing="15" style="                     -fx-background-color: #1f1f1f;                     -fx-background-radius: 20;                     -fx-padding: 20;                   ">

                <TableView fx:id="userTable" prefHeight="450" style="                              -fx-background-color: #1f1f1f;                              -fx-control-inner-background: #1f1f1f;                              -fx-table-cell-border-color: transparent;                              -fx-text-background-color: white;                            ">

                    <columns>

                        <TableColumn fx:id="userIdCol" prefWidth="100" text="ID" />

                        <TableColumn fx:id="usernameCol" prefWidth="220" text="USERNAME" />

                        <TableColumn fx:id="emailCol" prefWidth="300" text="EMAIL" />

                        <TableColumn fx:id="roleCol" prefWidth="180" text="ROLE" />

                    </columns>

                </TableView>

                <!-- BUTTONS -->
                <HBox alignment="CENTER_RIGHT" spacing="15">

                    <Button onAction="#handleDeleteUser" prefHeight="45" prefWidth="160" style="                                 -fx-background-color: #ff5252;                                 -fx-text-fill: white;                                 -fx-font-size: 14;                                 -fx-font-weight: bold;                                 -fx-background-radius: 14;                                 -fx-cursor: hand;                             " text="DELETE USER" />

                    <Button prefHeight="45" prefWidth="160" style="                                 -fx-background-color: #d4af37;                                 -fx-text-fill: black;                                 -fx-font-size: 14;                                 -fx-font-weight: bold;                                 -fx-background-radius: 14;                                 -fx-cursor: hand;                             " text="UPDATE USER" />

                </HBox>

            </VBox>

        </VBox>

    </HBox>

</AnchorPane>
