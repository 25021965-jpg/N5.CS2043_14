<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: #F1F5F9;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AuctionHistoryController">

    <!-- ================= LEFT PANEL ================= -->
    <VBox layoutX="0.0" layoutY="0.0" prefHeight="720.0" prefWidth="250.0" spacing="15" style="-fx-background-color: black;">

        <padding>
            <Insets bottom="20" left="20" right="20" top="30" />
        </padding>

        <!-- TITLE -->
        <Label style="-fx-text-fill: white;                       -fx-font-size: 24px;                       -fx-font-weight: bold;" text="USER PANEL" />

        <Separator />
      <Button fx:id="favoriteBtn11" prefHeight="45" prefWidth="210" style="-fx-background-color: #334155;                        -fx-text-fill: white;                        -fx-font-size: 14px;" text="Information " />

        <!-- MENU -->
        <Button fx:id="historyBtn" prefHeight="45" prefWidth="210" style="-fx-background-color: #475569;                        -fx-text-fill: white;                        -fx-font-size: 14px;                        -fx-font-weight: bold;" text="Auction History" />

        <Button fx:id="createdAuctionBtn" prefHeight="45" prefWidth="210" style="-fx-background-color: #334155;                        -fx-text-fill: white;                        -fx-font-size: 14px;" text="Your Auctions" />

        <Button fx:id="favoriteBtn" prefHeight="45" prefWidth="210" style="-fx-background-color: #334155;                        -fx-text-fill: white;                        -fx-font-size: 14px;" text="Favourite " />
      <Button fx:id="favoriteBtn1" layoutX="30.0" layoutY="227.0" prefHeight="45" prefWidth="210" style="-fx-background-color: #334155;                        -fx-text-fill: white;                        -fx-font-size: 14px;" text="Account Balance" />

        <Button fx:id="logoutBtn" prefHeight="45" prefWidth="210" style="-fx-background-color: d4af37; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" text="Log Out" />

        <Button fx:id="deleteAccountBtn" prefHeight="45" prefWidth="210" style="-fx-background-color: #DC2626;                        -fx-text-fill: white;                        -fx-font-size: 14px;                        -fx-font-weight: bold;" text="DELETE ACCOUNT" />

        <VBox prefHeight="250" />

        <!-- BACK -->
        <Button fx:id="backHomeBtn" prefHeight="45" prefWidth="210" style="-fx-background-color: #2563EB;                        -fx-text-fill: white;                        -fx-font-size: 14px;                        -fx-font-weight: bold;" text="← Back To Home" />
    </VBox>

    <!-- ================= RIGHT CONTENT ================= -->

    <!-- TITLE -->
    <Label layoutX="290.0" layoutY="35.0" style="-fx-font-size: 32px;                   -fx-font-weight: bold;                   -fx-text-fill: #0F172A;" text="Lịch Sử Đấu Giá" />

    <!-- FILTER -->
    <HBox alignment="CENTER_LEFT" layoutX="290.0" layoutY="100.0" spacing="15">

        <Label style="-fx-font-size: 16px;                       -fx-font-weight: bold;" text="Bộ lọc:" />

        <ComboBox fx:id="filterComboBox" prefHeight="40" prefWidth="220" promptText="Chọn trạng thái" />

    </HBox>

    <!-- PRODUCT LIST -->
    <ScrollPane fitToWidth="true" layoutX="290.0" layoutY="160.0" prefHeight="520.0" prefWidth="750.0" style="-fx-background-color: transparent;">

        <content>

            <VBox prefWidth="720" spacing="20" style="-fx-padding: 10;">

                <!-- ================= ITEM 1 ================= -->
                <HBox prefHeight="140" prefWidth="720" spacing="20" style="-fx-background-color: white;                              -fx-background-radius: 15;                              -fx-border-radius: 15;                              -fx-border-color: #CBD5E1;                              -fx-padding: 15;">

                    <!-- IMAGE -->
                    <Region prefHeight="110" prefWidth="120" style="-fx-background-color: #CBD5E1;                                    -fx-background-radius: 10;" />

                    <!-- PRODUCT INFO -->
                    <VBox spacing="10">

                        <Label style="-fx-font-size: 20px;                                       -fx-font-weight: bold;" text="Macbook Pro M3" />

                        <Label style="-fx-font-size: 15px;" text="Giá hiện tại: 32.000.000 VNĐ" />

                        <Label style="-fx-font-size: 15px;                                       -fx-text-fill: #16A34A;                                       -fx-font-weight: bold;" text="Trạng thái: Đang đấu giá" />

                        <Button prefHeight="35" prefWidth="140" style="-fx-background-color: #2563EB;                                        -fx-text-fill: white;                                        -fx-font-weight: bold;" text="Xem Chi Tiết" />
                    </VBox>

                </HBox>

                <!-- ================= ITEM 2 ================= -->
                <HBox prefHeight="140" prefWidth="720" spacing="20" style="-fx-background-color: white;                              -fx-background-radius: 15;                              -fx-border-radius: 15;                              -fx-border-color: #CBD5E1;                              -fx-padding: 15;">

                    <!-- IMAGE -->
                    <Region prefHeight="110" prefWidth="120" style="-fx-background-color: #CBD5E1;                                    -fx-background-radius: 10;" />

                    <!-- PRODUCT INFO -->
                    <VBox spacing="10">

                        <Label style="-fx-font-size: 20px;                                       -fx-font-weight: bold;" text="Iphone 15 Pro Max" />

                        <Label style="-fx-font-size: 15px;" text="Giá cuối cùng: 24.500.000 VNĐ" />

                        <Label style="-fx-font-size: 15px;                                       -fx-text-fill: #DC2626;                                       -fx-font-weight: bold;" text="Trạng thái: Đã kết thúc" />

                        <Button prefHeight="35" prefWidth="140" style="-fx-background-color: #2563EB;                                        -fx-text-fill: white;                                        -fx-font-weight: bold;" text="Xem Chi Tiết" />
                    </VBox>

                </HBox>

                <!-- ================= ITEM 3 ================= -->
                <HBox prefHeight="140" prefWidth="720" spacing="20" style="-fx-background-color: white;                              -fx-background-radius: 15;                              -fx-border-radius: 15;                              -fx-border-color: #CBD5E1;                              -fx-padding: 15;">

                    <!-- IMAGE -->
                    <Region prefHeight="110" prefWidth="120" style="-fx-background-color: #CBD5E1;                                    -fx-background-radius: 10;" />

                    <!-- PRODUCT INFO -->
                    <VBox spacing="10">

                        <Label style="-fx-font-size: 20px;                                       -fx-font-weight: bold;" text="Gaming Keyboard" />

                        <Label style="-fx-font-size: 15px;" text="Giá hiện tại: 1.200.000 VNĐ" />

                        <Label style="-fx-font-size: 15px;                                       -fx-text-fill: #16A34A;                                       -fx-font-weight: bold;" text="Trạng thái: Đang đấu giá" />

                        <Button prefHeight="35" prefWidth="140" style="-fx-background-color: #2563EB;                                        -fx-text-fill: white;                                        -fx-font-weight: bold;" text="Xem Chi Tiết" />
                    </VBox>

                </HBox>

            </VBox>

        </content>

    </ScrollPane>

</AnchorPane>
