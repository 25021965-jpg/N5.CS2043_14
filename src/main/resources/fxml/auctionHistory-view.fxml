<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane
        prefHeight="720.0"
        prefWidth="1080.0"
        style="
            -fx-background-color: #F8FAFC;
            -fx-border-color: #D4AF37;
            -fx-border-width: 6;
        "
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="client.controller.AuctionHistoryController">

    <!-- LEFT MENU -->
    <VBox
            prefWidth="250.0"
            spacing="18"
            style="
                -fx-background-color: #000000;
                -fx-border-color: #D4AF37;
                -fx-border-width: 0 3 0 0;
                -fx-padding: 30 20 20 20;
            "
            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0">

        <!-- TITLE -->
        <VBox alignment="CENTER" spacing="6">

            <Label
                    text="Auction System"
                    style="
                        -fx-text-fill: white;
                        -fx-font-size: 26px;
                        -fx-font-weight: bold;
                    ">

                <font>
                    <Font name="Berlin Sans FB Demi Bold" size="14.0"/>
                </font>

            </Label>

            <Label
                    text="USER PANEL"
                    style="
                        -fx-text-fill: #94A3B8;
                        -fx-font-size: 13px;
                    "/>

        </VBox>

        <Separator style="-fx-background-color: #334155;"/>

        <!-- MENU BUTTONS -->
        <Button
                fx:id="infoBtn"
                text="Profile"
                prefHeight="45"
                prefWidth="210"
                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

        <Button
                fx:id="historyBtn"
                text="Auction History"
                prefHeight="45"
                prefWidth="210"
                style="
                    -fx-background-color: #475569;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

        <Button
                fx:id="createdAuctionBtn"
                text="My Auctions"
                prefHeight="45"
                prefWidth="210"
                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

        <Button
                fx:id="favoriteBtn"
                text="Favourite"
                prefHeight="45"
                prefWidth="210"
                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

        <Button
                fx:id="balanceBtn"
                text="Account Balance"
                prefHeight="45"
                prefWidth="210"
                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

        <Button
                fx:id="logoutBtn"
                text="Log Out"
                prefHeight="48"
                prefWidth="210"
                style="
                    -fx-background-color: #D4AF37;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

        <Button
                fx:id="deleteAccountBtn"
                text="DELETE ACCOUNT"
                prefHeight="48"
                prefWidth="210"
                style="
                    -fx-background-color: #EF4444;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

        <Region VBox.vgrow="ALWAYS"/>

        <Button
                fx:id="backHomeBtn"
                text="← Back To Home"
                prefHeight="48"
                prefWidth="210"
                style="
                    -fx-background-color: #2563EB;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

    </VBox>

    <!-- PAGE TITLE -->
    <Label
            layoutX="290.0"
            layoutY="35.0"
            text="Auction History"
            style="
                -fx-font-size: 32px;
                -fx-font-weight: bold;
                -fx-text-fill: #0F172A;
            "/>

    <!-- FILTER -->
    <HBox
            layoutX="290.0"
            layoutY="100.0"
            alignment="CENTER_LEFT"
            spacing="15">

        <Label
                text="Status"
                style="
                    -fx-font-size: 16px;
                    -fx-font-family: 'Berlin Sans FB Demi Bold';
                    -fx-font-weight: bold;
                    -fx-text-fill: #334155;
                ">

            <font>
                <Font name="Berlin Sans FB Demi Bold" size="12.0"/>
            </font>

        </Label>

        <ComboBox
                fx:id="statusFilterComboBox"
                prefHeight="40"
                prefWidth="220"
                promptText="Select Status"
                style="
                    -fx-background-radius: 8;
                    -fx-border-radius: 8;
                    -fx-border-color: #D4AF37;
                "/>

        <Label
                text="Category"
                style="
                    -fx-font-size: 16px;
                    -fx-font-family: 'Berlin Sans FB Demi Bold';
                    -fx-font-weight: bold;
                    -fx-text-fill: #334155;
                ">

            <font>
                <Font name="Berlin Sans FB Demi Bold" size="12.0"/>
            </font>

        </Label>

        <ComboBox
                fx:id="categoryFilterComboBox"
                prefHeight="40"
                prefWidth="220"
                promptText="Select Category"
                style="
                    -fx-background-radius: 8;
                    -fx-border-radius: 8;
                    -fx-border-color: #D4AF37;
                "/>

    </HBox>

    <!-- HISTORY LIST -->
    <ScrollPane
            layoutX="290.0"
            layoutY="160.0"
            prefHeight="520.0"
            prefWidth="760.0"
            fitToWidth="true"
            style="-fx-background-color: transparent;">

        <VBox
                fx:id="historyContainer"
                prefWidth="730"
                spacing="20"
                style="-fx-padding: 10;">

            <!-- AUCTION CARD -->
            <HBox
                    fx:id="auctionCard"
                    prefHeight="150"
                    prefWidth="730"
                    spacing="20"
                    style="
                        -fx-background-color: white;
                        -fx-background-radius: 15;
                        -fx-border-radius: 15;
                        -fx-border-color: #D4AF37;
                        -fx-border-width: 2;
                        -fx-padding: 15;
                        -fx-cursor: hand;
                    ">

                <!-- IMAGE -->
                <Region
                        prefHeight="120"
                        prefWidth="130"
                        style="
                            -fx-background-color: #E2E8F0;
                            -fx-background-radius: 10;
                        "/>

                <!-- INFO -->
                <VBox spacing="10">

                    <Label
                            text="Auction Item"
                            style="
                                -fx-font-size: 20px;
                                -fx-font-weight: bold;
                                -fx-text-fill: #0F172A;
                            "/>

                    <Label
                            text="Current Price: -- VNĐ"
                            style="
                                -fx-font-size: 15px;
                                -fx-text-fill: #334155;
                            "/>

                    <Label
                            text="Category: Electronics"
                            style="
                                -fx-font-size: 15px;
                                -fx-text-fill: #7C3AED;
                                -fx-font-weight: bold;
                            "/>

                    <Label
                            text="End Date: --/--/----"
                            style="
                                -fx-font-size: 15px;
                                -fx-text-fill: #64748B;
                            "/>

                    <Label
                            text="Status: Active"
                            style="
                                -fx-font-size: 15px;
                                -fx-font-weight: bold;
                                -fx-text-fill: #16A34A;
                            "/>

                </VBox>

            </HBox>

        </VBox>

    </ScrollPane>

</AnchorPane>