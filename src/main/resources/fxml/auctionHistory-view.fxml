<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0" style="-fx-background-color: white;                    -fx-border-color: #D4AF37;                    -fx-border-width: 6;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AuctionHistoryController">

    <!-- LEFT MENU -->
    <VBox prefWidth="250.0" spacing="18" style="-fx-background-color: #000000;                  -fx-border-color: #D4AF37;                  -fx-border-width: 0 3 0 0;                  -fx-padding: 30 20 20 20;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">

        <VBox alignment="CENTER" spacing="6">

            <Label style="-fx-text-fill: white;                           -fx-font-size: 26px;                           -fx-font-weight: bold;" text="Auction System" />

            <Label style="-fx-text-fill: #94A3B8;                           -fx-font-size: 13px;" text="USER PANEL" />

        </VBox>

        <Separator style="-fx-background-color: #334155;" />

        <Button fx:id="infoBtn" prefHeight="45" prefWidth="210" style="-fx-background-color: #334155;                        -fx-text-fill: white;                        -fx-font-size: 15px;                        -fx-font-weight: bold;                        -fx-background-radius: 8;" text="Profile" />

        <Button fx:id="historyBtn" prefHeight="45" prefWidth="210" style="-fx-background-color: #475569;                        -fx-text-fill: white;                        -fx-font-size: 15px;                        -fx-font-weight: bold;                        -fx-background-radius: 8;" text="Auction History" />

        <Button fx:id="createdAuctionBtn" prefHeight="45" prefWidth="210" style="-fx-background-color: #334155;                        -fx-text-fill: white;                        -fx-font-size: 15px;                        -fx-font-weight: bold;                        -fx-background-radius: 8;" text="Your Auctions" />

        <Button fx:id="favoriteBtn" prefHeight="45" prefWidth="210" style="-fx-background-color: #334155;                        -fx-text-fill: white;                        -fx-font-size: 15px;                        -fx-font-weight: bold;                        -fx-background-radius: 8;" text="Favourite" />

        <Button fx:id="balanceBtn" prefHeight="45" prefWidth="210" style="-fx-background-color: #334155;                        -fx-text-fill: white;                        -fx-font-size: 15px;                        -fx-font-weight: bold;                        -fx-background-radius: 8;" text="Account Balance" />

        <Button fx:id="logoutBtn" prefHeight="48" prefWidth="210" style="-fx-background-color: #D4AF37;                        -fx-text-fill: white;                        -fx-font-size: 15px;                        -fx-font-weight: bold;                        -fx-background-radius: 8;" text="Log Out" />

        <Button fx:id="deleteAccountBtn" prefHeight="48" prefWidth="210" style="-fx-background-color: #EF4444;                        -fx-text-fill: white;                        -fx-font-size: 15px;                        -fx-font-weight: bold;                        -fx-background-radius: 8;" text="DELETE ACCOUNT" />

        <Region VBox.vgrow="ALWAYS" />

        <Button fx:id="backHomeBtn" prefHeight="48" prefWidth="210" style="-fx-background-color: #2563EB;                        -fx-text-fill: white;                        -fx-font-size: 15px;                        -fx-font-weight: bold;                        -fx-background-radius: 8;" text="← Back To Home" />

    </VBox>

    <!-- RIGHT CONTENT -->
    <VBox layoutX="290.0" layoutY="35.0" spacing="20">

        <!-- TITLE -->
        <Label style="-fx-font-size: 32px;                       -fx-font-weight: bold;                       -fx-text-fill: #0F172A;" text="Auction History" />

        <!-- FILTER -->
        <HBox alignment="CENTER_LEFT" spacing="15">

            <Label style="-fx-font-size: 16px;                           -fx-font-weight: bold;                           -fx-text-fill: #334155;" text="Filter" />

            <ComboBox fx:id="filterComboBox" prefHeight="40" prefWidth="220" promptText="Select status" style="-fx-background-radius: 8;                              -fx-border-radius: 8;                              -fx-border-color: #D4AF37;" />

        </HBox>

        <!-- LIST -->
        <ScrollPane fitToWidth="true" prefHeight="540.0" prefWidth="730.0" style="-fx-background-color: transparent;">

            <content>

                <VBox spacing="18" style="-fx-padding: 5 10 5 5;">

                    <!-- ITEM 1 -->
                    <HBox prefHeight="150" prefWidth="700" spacing="20" style="-fx-background-color: white;                                  -fx-border-color: #D4AF37;                                  -fx-border-width: 2;                                  -fx-border-radius: 12;                                  -fx-background-radius: 12;                                  -fx-padding: 15;">

                        <!-- IMAGE -->
                        <Region prefHeight="120" prefWidth="130" style="-fx-background-color: #CBD5E1;                                        -fx-background-radius: 10;" />

                        <!-- INFO -->
                        <VBox spacing="10">

                            <Label style="-fx-font-size: 22px;                                           -fx-font-weight: bold;                                           -fx-text-fill: #0F172A;" text="Auction Item" />

                            <Label style="-fx-font-size: 15px;                                           -fx-text-fill: #334155;" text="Current Price: -- VNĐ" />

                            <Label style="-fx-font-size: 15px;                                           -fx-text-fill: #16A34A;                                           -fx-font-weight: bold;" text="Status: Active" />

                            <Label style="-fx-font-size: 14px;                                           -fx-text-fill: #64748B;" text="End Time: --/--/----" />

                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- ACTION -->
                        <VBox alignment="CENTER">

                            <Button prefHeight="40" prefWidth="140" style="-fx-background-color: #2563EB;                                            -fx-text-fill: white;                                            -fx-font-size: 14px;                                            -fx-font-weight: bold;                                            -fx-background-radius: 8;" text="View Detail" />

                        </VBox>

                    </HBox>

                    <!-- ITEM 2 -->
                    <HBox prefHeight="150" prefWidth="700" spacing="20" style="-fx-background-color: white;                                  -fx-border-color: #D4AF37;                                  -fx-border-width: 2;                                  -fx-border-radius: 12;                                  -fx-background-radius: 12;                                  -fx-padding: 15;">

                        <Region prefHeight="120" prefWidth="130" style="-fx-background-color: #CBD5E1;                                        -fx-background-radius: 10;" />

                        <VBox spacing="10">

                            <Label style="-fx-font-size: 22px;                                           -fx-font-weight: bold;                                           -fx-text-fill: #0F172A;" text="Auction Item" />

                            <Label style="-fx-font-size: 15px;                                           -fx-text-fill: #334155;" text="Current Price: -- VNĐ" />

                            <Label style="-fx-font-size: 15px;                                           -fx-text-fill: #DC2626;                                           -fx-font-weight: bold;" text="Status: Finished" />

                            <Label style="-fx-font-size: 14px;                                           -fx-text-fill: #64748B;" text="End Time: --/--/----" />

                        </VBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <VBox alignment="CENTER">

                            <Button prefHeight="40" prefWidth="140" style="-fx-background-color: #2563EB;                                            -fx-text-fill: white;                                            -fx-font-size: 14px;                                            -fx-font-weight: bold;                                            -fx-background-radius: 8;" text="View Detail" />

                        </VBox>

                    </HBox>

                </VBox>

            </content>

        </ScrollPane>

    </VBox>

</AnchorPane>
