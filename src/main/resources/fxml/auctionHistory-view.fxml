<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.layout.FlowPane?>
<AnchorPane
        style="
            -fx-background-color: #F8FAFC;
            -fx-border-color: #D4AF37;
            -fx-border-width: 6;
        "
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="client.controller.AuctionHistoryController">

    <fx:include
            source="sidebar-view.fxml"

            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"/>

    <!-- PAGE TITLE -->
    <Label
            AnchorPane.topAnchor="30.0"
            AnchorPane.leftAnchor="280.0"
            text="Auction History"
            style="
                -fx-font-size: 32px;
                -fx-font-weight: bold;
                -fx-text-fill: #0F172A;
            "/>

    <!-- FILTER -->
    <HBox
            alignment="CENTER_LEFT"
            spacing="15"
            AnchorPane.topAnchor="95.0"
            AnchorPane.leftAnchor="280.0"
            AnchorPane.rightAnchor="40.0">

        <Label
                text="Status"
                style="
                    -fx-font-size: 16px;
                    -fx-font-family: 'Berlin Sans FB Demi Bold';
                    -fx-font-weight: bold;
                    -fx-text-fill: #334155;
                ">

            <font>
                <Font name="Berlin Sans FB Demi Bold" size="12.0"/>
            </font>

        </Label>

        <ComboBox
                fx:id="statusFilterComboBox"
                prefHeight="40"
                prefWidth="220"
                promptText="Select Status"
                style="
                    -fx-background-radius: 8;
                    -fx-border-radius: 8;
                    -fx-border-color: #D4AF37;
                "/>

        <Label
                text="Category"
                style="
                    -fx-font-size: 16px;
                    -fx-font-family: 'Berlin Sans FB Demi Bold';
                    -fx-font-weight: bold;
                    -fx-text-fill: #334155;
                ">

            <font>
                <Font name="Berlin Sans FB Demi Bold" size="12.0"/>
            </font>

        </Label>

        <ComboBox
                fx:id="categoryFilterComboBox"
                prefHeight="40"
                prefWidth="220"
                promptText="Select Category"
                style="
                    -fx-background-radius: 8;
                    -fx-border-radius: 8;
                    -fx-border-color: #D4AF37;
                "/>

    </HBox>

    <!-- HISTORY LIST -->
    <ScrollPane
            fx:id="scrollPane"
            AnchorPane.topAnchor="160.0"
            AnchorPane.leftAnchor="280.0"
            AnchorPane.rightAnchor="10.0"
            AnchorPane.bottomAnchor="10.0"
            fitToWidth="true"
            style="-fx-background-color: transparent;">

        <FlowPane
                fx:id="historyContainer"
                prefWidth="730"
                hgap="20"
                vgap="20"
                prefWrapLength="750">
        </FlowPane>

    </ScrollPane>

</AnchorPane>