<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0"
            prefWidth="1080.0"
            style="-fx-background-color: #F8FAFC;
                   -fx-border-color: #D4AF37;
                   -fx-border-width: 6;"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.AuctionHistoryController">

    <!-- LEFT MENU -->
    <VBox prefWidth="250.0"
          spacing="18"
          style="-fx-background-color: #000000;
                 -fx-border-color: #D4AF37;
                 -fx-border-width: 0 3 0 0;
                 -fx-padding: 30 20 20 20;"
          AnchorPane.bottomAnchor="0.0"
          AnchorPane.leftAnchor="0.0"
          AnchorPane.topAnchor="0.0">

        <!-- TITLE -->
        <VBox alignment="CENTER" spacing="6">

            <Label text="Auction System"
                   style="-fx-text-fill: white;
                          -fx-font-size: 26px;
                          -fx-font-weight: bold;" />

            <Label text="USER PANEL"
                   style="-fx-text-fill: #94A3B8;
                          -fx-font-size: 13px;" />

        </VBox>

        <Separator style="-fx-background-color: #334155;" />

        <!-- PROFILE -->
        <Button fx:id="infoBtn"
                prefHeight="45"
                prefWidth="210"
                text="Profile"
                style="-fx-background-color: #334155;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;" />

        <!-- HISTORY -->
        <Button fx:id="historyBtn"
                prefHeight="45"
                prefWidth="210"
                text="Auction History"
                style="-fx-background-color: #475569;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;" />

        <!-- YOUR AUCTIONS -->
        <Button fx:id="createdAuctionBtn"
                prefHeight="45"
                prefWidth="210"
                text="Your Auctions"
                style="-fx-background-color: #334155;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;" />

        <!-- FAVOURITE -->
        <Button fx:id="favoriteBtn"
                prefHeight="45"
                prefWidth="210"
                text="Favourite"
                style="-fx-background-color: #334155;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;" />

        <!-- BALANCE -->
        <Button fx:id="balanceBtn"
                prefHeight="45"
                prefWidth="210"
                text="Account Balance"
                style="-fx-background-color: #334155;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;" />

        <!-- LOG OUT -->
        <Button fx:id="logoutBtn"
                prefHeight="48"
                prefWidth="210"
                text="Log Out"
                style="-fx-background-color: #D4AF37;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;" />

        <!-- DELETE -->
        <Button fx:id="deleteAccountBtn"
                prefHeight="48"
                prefWidth="210"
                text="DELETE ACCOUNT"
                style="-fx-background-color: #EF4444;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;" />

        <Region VBox.vgrow="ALWAYS" />

        <!-- BACK -->
        <Button fx:id="backHomeBtn"
                prefHeight="48"
                prefWidth="210"
                text="← Back To Home"
                style="-fx-background-color: #2563EB;
                       -fx-text-fill: white;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;" />

    </VBox>

    <!-- PAGE TITLE -->
    <Label layoutX="290.0"
           layoutY="35.0"
           text="Auction History"
           style="-fx-font-size: 32px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #0F172A;" />

    <!-- FILTER -->
    <HBox alignment="CENTER_LEFT"
          layoutX="290.0"
          layoutY="100.0"
          spacing="15">

        <Label text="Filter"
               style="-fx-font-size: 16px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #334155;" />

        <ComboBox fx:id="filterComboBox"
                  prefHeight="40"
                  prefWidth="220"
                  promptText="Select status" />

    </HBox>

    <!-- LIST -->
    <ScrollPane fitToWidth="true"
                layoutX="290.0"
                layoutY="160.0"
                prefHeight="520.0"
                prefWidth="760.0"
                style="-fx-background-color: transparent;">

        <VBox prefWidth="730"
              spacing="20"
              style="-fx-padding: 10;">

            <!-- ITEM -->
            <HBox prefHeight="150"
                  prefWidth="730"
                  spacing="20"
                  style="-fx-background-color: white;
                         -fx-background-radius: 15;
                         -fx-border-radius: 15;
                         -fx-border-color: #D4AF37;
                         -fx-border-width: 2;
                         -fx-padding: 15;">

                <!-- IMAGE -->
                <Region prefHeight="120"
                        prefWidth="130"
                        style="-fx-background-color: #E2E8F0;
                               -fx-background-radius: 10;" />

                <!-- INFO -->
                <VBox spacing="10">

                    <Label text="Auction Item"
                           style="-fx-font-size: 20px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #0F172A;" />

                    <Label text="Current Price: -- VNĐ"
                           style="-fx-font-size: 15px;
                                  -fx-text-fill: #334155;" />

                    <Label text="End Date: --/--/----"
                           style="-fx-font-size: 15px;
                                  -fx-text-fill: #64748B;" />

                    <Label text="Status: Active"
                           style="-fx-font-size: 15px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #16A34A;" />

                    <HBox spacing="10">

                        <Button text="View"
                                prefHeight="35"
                                prefWidth="100"
                                style="-fx-background-color: #2563EB;
                                       -fx-text-fill: white;
                                       -fx-font-weight: bold;
                                       -fx-background-radius: 8;" />

                    </HBox>

                </VBox>

            </HBox>

        </VBox>

    </ScrollPane>

</AnchorPane>