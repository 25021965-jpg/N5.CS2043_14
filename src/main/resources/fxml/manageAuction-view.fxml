<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane style="-fx-background-color: linear-gradient(to bottom right,#0f0f0f,#1b1b1b); -fx-border-color: #D4AF37;         -fx-border-width: 6;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.admin.ManageAuctionController">

    <!-- TITLE -->
    <VBox alignment="CENTER" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="20">
        <Label text="ADMIN DASHBOARD" textFill="#d4af37">
            <font>
                <Font name="Berlin Sans FB Demi Bold" size="42" />
            </font>
        </Label>
    </VBox>

    <!-- MAIN CONTAINER -->
    <HBox spacing="25" AnchorPane.bottomAnchor="35" AnchorPane.leftAnchor="35" AnchorPane.rightAnchor="35" AnchorPane.topAnchor="100">

        <!-- LEFT MENU -->
        <!-- LEFT MENU -->
        <VBox maxWidth="260" minWidth="260" prefHeight="640.0" prefWidth="260" spacing="18.0" style="         -fx-background-color: #181818;         -fx-background-radius: 25;         -fx-border-radius: 25;         -fx-border-color: #2d2d2d;         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45),15,0,0,5);     " HBox.hgrow="NEVER">
            <padding>
                <Insets bottom="30" left="20" right="20" top="30" />
            </padding>

            <!-- TITLE -->
            <VBox alignment="CENTER" spacing="6">

                <Label style="                     -fx-text-fill: white;                     -fx-font-size: 26px;                     -fx-font-weight: bold;                 " text="Auction System">

                    <font>
                        <Font name="Berlin Sans FB Demi Bold" size="24.0" />
                    </font>

                </Label>

                <Label style="                     -fx-text-fill: #94A3B8;                     -fx-font-size: 13px;                 " text="ADMIN PANEL" />

            </VBox>

            <Separator style="-fx-background-color: #334155;" />

            <!-- MENU BUTTONS -->
            <Button maxWidth="Infinity" onAction="#handleManageUsers" prefHeight="50" style="                         -fx-background-color: #334155;                         -fx-text-fill: white;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                         -fx-cursor: hand;                     " text="Manage Users" />

            <Button maxWidth="Infinity" onAction="#handleManageProducts" prefHeight="50" style="                         -fx-background-color: #334155;                         -fx-text-fill: white;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                         -fx-cursor: hand;                     " text="Manage Products" />

            <Button maxWidth="Infinity" onAction="#handleAuctionHistory" prefHeight="50" style="                         -fx-background-color: #334155;                         -fx-text-fill: white;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                         -fx-cursor: hand;                     " text="Auction History" />

            <Button maxWidth="Infinity" prefHeight="50" style="                         -fx-background-color: #162336;                         -fx-text-fill: white;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                         -fx-cursor: hand;                     " text="Manage Auctions" />

            <Region VBox.vgrow="ALWAYS" />

            <!-- LOGOUT -->
            <Button onAction="#handleLogout" prefHeight="50" prefWidth="216.0" style="                         -fx-background-color: #d4af37;                         -fx-text-fill: white;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                     " text="Log Out" />
        </VBox>

        <!-- RIGHT CONTENT -->
        <VBox spacing="20.0" style="                 -fx-background-color: #181818;                 -fx-background-radius: 25;                 -fx-border-radius: 25;                 -fx-border-color: #2d2d2d;                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45),15,0,0,5);               " HBox.hgrow="ALWAYS">

            <padding>
                <Insets bottom="25" left="25" right="25" top="25" />
            </padding>

            <!-- TOP BAR -->
            <HBox alignment="CENTER_LEFT" spacing="15">

                <Label text="AUCTION MANAGEMENT" textFill="#d4af37">

                    <font>
                        <Font name="Arial Bold" size="26" />
                    </font>

                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <TextField fx:id="searchAuctionField" maxWidth="350" minWidth="180" prefHeight="42" prefWidth="250" promptText="Search auction..." style="                             -fx-background-color: #262626;                             -fx-text-fill: white;                             -fx-prompt-text-fill: #999;                             -fx-background-radius: 14;                             -fx-border-radius: 14;                             -fx-border-color: #3a3a3a;                            " />

                <Button onAction="#handleReloadAuctions" prefHeight="42" prefWidth="110" style="-fx-background-color: #d4af37; -fx-text-fill: black; -fx-font-weight: bold; -fx-background-radius: 14;" text="Reload" />

            </HBox>

            <!-- TABLE CARD -->
            <VBox spacing="15" style="                     -fx-background-color: #1f1f1f;                     -fx-background-radius: 20;                     -fx-padding: 20;                   " VBox.vgrow="ALWAYS">

                <TableView fx:id="auctionTable" style="                              -fx-background-color: #1f1f1f;                              -fx-control-inner-background: #1f1f1f;                              -fx-table-cell-border-color: transparent;                              -fx-text-background-color: white;                            " VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="auctionIdCol" text="AUCTION ID" />

                        <TableColumn fx:id="auctionItemCol" text="ITEM" />

                        <TableColumn fx:id="sellerCol" text="SELLER" />

                        <TableColumn fx:id="currentBidCol" text="CURRENT BID" />

                        <TableColumn fx:id="auctionStatusCol" text="STATUS" />

                    </columns>

                </TableView>

                <!-- BUTTONS -->
                <HBox alignment="CENTER_RIGHT" spacing="15">

                    <Button onAction="#handleResumeAuction" prefHeight="45" prefWidth="180" style="                                 -fx-background-color: #43a047;                                 -fx-text-fill: white;                                 -fx-font-size: 14;                                 -fx-font-weight: bold;                                 -fx-background-radius: 14;                             " text="RESUME AUCTION" />

                    <Button onAction="#handleStopAuction" prefHeight="45" prefWidth="180" style="                                 -fx-background-color: #d4af37;                                 -fx-text-fill: white;                                 -fx-font-size: 14;                                 -fx-font-weight: bold;                                 -fx-background-radius: 14;                             " text="STOP AUCTION" />

                    <Button onAction="#handleCancelAuction" prefHeight="45" prefWidth="180" style="                                 -fx-background-color: #ff5252;                                 -fx-text-fill: white;                                 -fx-font-size: 14;                                 -fx-font-weight: bold;                                 -fx-background-radius: 14;                             " text="CANCEL AUCTION" />

                </HBox>

            </VBox>

        </VBox>

    </HBox>

</AnchorPane>
