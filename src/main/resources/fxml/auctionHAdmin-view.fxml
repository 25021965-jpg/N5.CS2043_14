<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="1300.0" style="-fx-background-color: linear-gradient(to bottom right,#0f0f0f,#1b1b1b);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.admin.AuctionHistoryAdminController">

    <!-- TITLE -->
    <Label layoutX="455.0" layoutY="25.0" text="AUCTION HISTORY" textFill="#d4af37">

        <font>
            <Font name="Berlin Sans FB Demi Bold" size="42.0" />
        </font>

    </Label>

    <!-- MAIN CONTAINER -->
    <HBox layoutX="35.0" layoutY="100.0" prefHeight="640.0" prefWidth="1230.0" spacing="25.0">

        <!-- LEFT MENU -->
        <VBox prefHeight="640.0" prefWidth="260.0" spacing="18.0" style="                 -fx-background-color: #181818;                 -fx-background-radius: 25;                 -fx-border-radius: 25;                 -fx-border-color: #2d2d2d;                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45),15,0,0,5);               ">

            <padding>
                <Insets bottom="30" left="20" right="20" top="30" />
            </padding>

            <!-- ADMIN -->
            <VBox alignment="CENTER" spacing="10">

                <Label text="ADMIN" textFill="#d4af37">

                    <font>
                        <Font size="28" />
                    </font>

                </Label>

                <Separator />

            </VBox>

            <!-- MENU -->

            <Button onAction="#handleManageUsers" prefHeight="50" prefWidth="215.0" style="                         -fx-background-color: #262626;                         -fx-text-fill: white;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                     " text="Manage Users" />

            <Button onAction="#handleManageProducts" prefHeight="50" prefWidth="211.0" style="                         -fx-background-color: #262626;                         -fx-text-fill: white;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                     " text="Manage Products" />

            <Button prefHeight="50" prefWidth="212.0" style="                         -fx-background-color: #d4af37;                         -fx-text-fill: black;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                     " text="Auction History" />

            <Button onAction="#handleManageAuctions" prefHeight="50" prefWidth="211.0" style="                         -fx-background-color: #262626;                         -fx-text-fill: white;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                     " text="Manage Auctions" />

            <Region VBox.vgrow="ALWAYS" />

            <!-- LOGOUT -->

            <Button onAction="#handleLogout" prefHeight="50" prefWidth="216.0" style="                         -fx-background-color: #d32f2f;                         -fx-text-fill: white;                         -fx-background-radius: 15;                         -fx-font-size: 15;                         -fx-font-weight: bold;                     " text="Logout" />

        </VBox>

        <!-- RIGHT CONTENT -->
        <VBox prefHeight="640.0" prefWidth="940.0" spacing="20.0" style="                 -fx-background-color: #181818;                 -fx-background-radius: 25;                 -fx-border-radius: 25;                 -fx-border-color: #2d2d2d;                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45),15,0,0,5);               ">

            <padding>
                <Insets bottom="25" left="25" right="25" top="25" />
            </padding>

            <!-- TOP BAR -->
            <HBox alignment="CENTER_LEFT" spacing="15">

                <Label text="AUCTION HISTORY" textFill="#d4af37">

                    <font>
                        <Font name="Arial Bold" size="26" />
                    </font>

                </Label>

                <Region HBox.hgrow="ALWAYS" />

                <TextField fx:id="searchAuctionField" prefHeight="42" prefWidth="250" promptText="Search auction..." style="                             -fx-background-color: #262626;                             -fx-text-fill: white;                             -fx-prompt-text-fill: #999;                             -fx-background-radius: 14;                             -fx-border-radius: 14;                             -fx-border-color: #3a3a3a;                            " />

                <Button onAction="#handleReloadAuctionHistory" prefHeight="42" prefWidth="110" style="                             -fx-background-color: #d4af37;                             -fx-text-fill: black;                             -fx-font-weight: bold;                             -fx-background-radius: 14;                         " text="Reload" />

            </HBox>

            <!-- TABLE CARD -->
            <VBox prefHeight="500" spacing="15" style="                     -fx-background-color: #1f1f1f;                     -fx-background-radius: 20;                     -fx-padding: 20;                   ">

                <TableView fx:id="auctionHistoryTable" prefHeight="450" style="                              -fx-background-color: #1f1f1f;                              -fx-control-inner-background: #1f1f1f;                              -fx-table-cell-border-color: transparent;                              -fx-text-background-color: white;                            ">

                    <columns>

                        <TableColumn fx:id="auctionIdCol" prefWidth="110" text="AUCTION ID" />

                        <TableColumn fx:id="itemNameCol" prefWidth="220" text="ITEM NAME" />

                        <TableColumn fx:id="winnerCol" prefWidth="180" text="WINNER" />

                        <TableColumn fx:id="finalBidCol" prefWidth="160" text="FINAL BID" />

                        <TableColumn fx:id="endDateCol" prefWidth="180" text="END DATE" />

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </HBox>

</AnchorPane>
