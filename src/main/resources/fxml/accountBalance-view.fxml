<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane
        prefHeight="720.0"
        prefWidth="1080.0"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="client.controller.AccountBalanceController"

        style="
            -fx-background-color: #F8FAFC;
            -fx-border-color: #D4AF37;
            -fx-border-width: 6;
        ">

    <!-- ===================================================== -->
    <!-- LEFT MENU -->
    <!-- ===================================================== -->

    <VBox
            prefWidth="250.0"
            spacing="18"

            AnchorPane.topAnchor="0.0"
            AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0"

            style="
                -fx-background-color: #000000;
                -fx-border-color: #D4AF37;
                -fx-border-width: 0 3 0 0;
                -fx-padding: 30 20 20 20;
            ">

        <!-- TITLE -->
        <VBox alignment="CENTER" spacing="6">

            <Label
                    text="Auction System"

                    style="
                        -fx-text-fill: white;
                        -fx-font-size: 26px;
                        -fx-font-weight: bold;
                    ">

                <font>
                    <Font
                            name="Berlin Sans FB Demi Bold"
                            size="24.0"/>
                </font>

            </Label>

            <Label
                    text="USER PANEL"

                    style="
                        -fx-text-fill: #94A3B8;
                        -fx-font-size: 13px;
                    "/>

        </VBox>

        <Separator style="-fx-background-color: #334155;"/>

        <!-- PROFILE -->
        <Button
                fx:id="infoBtn"
                text="Profile"

                prefHeight="45"
                prefWidth="210"

                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

        <!-- HISTORY -->
        <Button
                fx:id="historyBtn"
                text="Auction History"

                prefHeight="45"
                prefWidth="210"

                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

        <!-- MY AUCTIONS -->
        <Button
                fx:id="createdAuctionBtn"
                text="My Auctions"

                prefHeight="45"
                prefWidth="210"

                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

        <!-- FAVOURITE -->
        <Button
                fx:id="favoriteBtn"
                text="Favourite"

                prefHeight="45"
                prefWidth="210"

                style="
                    -fx-background-color: #334155;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
                    -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

        <!-- BALANCE -->
        <Button
                fx:id="balanceBtn"
                text="Account Balance"

                prefHeight="45"
                prefWidth="210"

                style="
        -fx-background-color: #475569;
        -fx-text-fill: white;
        -fx-font-size: 15px;
        -fx-font-weight: bold;
        -fx-background-radius: 8;
        "/>


        <!-- LOGOUT -->
        <Button
                fx:id="logoutBtn"
                text="Log Out"

                prefHeight="48"
                prefWidth="210"

                style="
                    -fx-background-color: #D4AF37;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
        -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

        <!-- DELETE ACCOUNT -->
        <Button
                fx:id="deleteAccountBtn"
                text="DELETE ACCOUNT"

                prefHeight="48"
                prefWidth="210"

                style="
                    -fx-background-color: #EF4444;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
        -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

        <Region VBox.vgrow="ALWAYS"/>

        <!-- BACK -->
        <Button
                fx:id="backHomeBtn"
                text="← Back To Home"

                prefHeight="48"
                prefWidth="210"

                style="
                    -fx-background-color: #2563EB;
                    -fx-text-fill: white;
                    -fx-font-size: 15px;
        -fx-font-weight: bold;
                    -fx-background-radius: 8;
                "/>

    </VBox>

    <!-- PAGE TITLE -->

    <Label
            layoutX="290.0"
            layoutY="35.0"
            text="Balance"

            style="
                -fx-font-size: 32px;
                -fx-font-family: 'Berlin Sans FB Demi Bold';
                -fx-font-weight: bold;
                -fx-text-fill: #0F172A;
            ">

        <font>
            <Font
                    name="Berlin Sans FB Demi Bold"
                    size="32.0"/>
        </font>

    </Label>

    <!-- BALANCE CARD -->

    <VBox
            layoutX="290.0"
            layoutY="100.0"
            prefWidth="760.0"
            spacing="10"

            style="
                -fx-background-color: white;
                -fx-background-radius: 20;
                -fx-border-radius: 20;
                -fx-border-color: #D4AF37;
                -fx-border-width: 2;
                -fx-padding: 25;
            ">

        <Label
                text="Current Balance"
                style="
                    -fx-text-fill: #64748B;
                    -fx-font-size: 18px;
                "/>

        <Label
                fx:id="balanceLabel"
                text="0 USD"

                style="
                    -fx-text-fill: #16A34A;
                    -fx-font-size: 42px;
                    -fx-font-weight: bold;
                "/>

    </VBox>

    <!-- ACTION AREA -->

    <HBox
            layoutX="290.0"
            layoutY="250.0"
            spacing="25">

        <!-- DEPOSIT -->

        <VBox
                prefWidth="360"
                spacing="18"

                style="
                    -fx-background-color: white;
                    -fx-background-radius: 18;
                    -fx-border-radius: 18;
                    -fx-border-color: #D4AF37;
                    -fx-border-width: 2;
                    -fx-padding: 25;
                ">

            <Label
                    text="Deposit Money"

                    style="
                        -fx-font-size: 24px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #0F172A;
                    "/>

            <TextField
                    fx:id="depositField"
                    prefHeight="45"
                    promptText="Enter amount"

                    style="
                        -fx-background-radius: 10;
                        -fx-border-radius: 10;
                        -fx-border-color: #CBD5E1;
                        -fx-font-size: 15px;
                    "/>

            <Button
                    fx:id="depositBtn"
                    text="Deposit"
                    onAction="#handleDeposit"

                    prefHeight="45"
                    prefWidth="300"

                    style="
                        -fx-background-color: #16A34A;
                        -fx-text-fill: white;
                        -fx-font-size: 15px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 10;
                    "/>

        </VBox>

        <!-- WITHDRAW -->

        <VBox
                prefWidth="360"
                spacing="18"

                style="
                    -fx-background-color: white;
                    -fx-background-radius: 18;
                    -fx-border-radius: 18;
                    -fx-border-color: #D4AF37;
                    -fx-border-width: 2;
                    -fx-padding: 25;
                ">

            <Label
                    text="Withdraw Money"

                    style="
                        -fx-font-size: 24px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #0F172A;
                    "/>

            <TextField
                    fx:id="withdrawField"
                    prefHeight="45"
                    promptText="Enter amount"

                    style="
                        -fx-background-radius: 10;
                        -fx-border-radius: 10;
                        -fx-border-color: #CBD5E1;
                        -fx-font-size: 15px;
                    "/>

            <Button
                    fx:id="withdrawBtn"
                    text="Withdraw"
                    onAction="#handleWithdraw"

                    prefHeight="45"
                    prefWidth="300"

                    style="
                        -fx-background-color: #EF4444;
                        -fx-text-fill: white;
                        -fx-font-size: 15px;
                        -fx-font-weight: bold;
                        -fx-background-radius: 10;
                    "/>

        </VBox>

    </HBox>

    <!-- TRANSACTION HISTORY -->

    <HBox
            layoutX="290.0"
            layoutY="500.0"
            prefWidth="760.0"
            alignment="CENTER_LEFT">

        <Label
                text="Transaction History"

                style="
                    -fx-font-size: 26px;
                    -fx-font-family: 'Berlin Sans FB Demi Bold';
                    -fx-font-weight: bold;
                    -fx-text-fill: #0F172A;
                "/>

        <Region HBox.hgrow="ALWAYS"/>

        <ComboBox
                fx:id="filterBox"
                prefWidth="180"
                promptText="Filter"

                style="-fx-background-radius:8;"/>

    </HBox>

    <ScrollPane
            layoutX="290.0"
            layoutY="545.0"

            prefWidth="760.0"
            prefHeight="145.0"

            fitToWidth="true">

        <VBox
                fx:id="transactionContainer"
                spacing="15"
                style="-fx-padding: 5;"/>

    </ScrollPane>

</AnchorPane>