<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.ComboBox?>
<AnchorPane prefHeight="720.0" prefWidth="1080.0" style="             -fx-background-color: #F8FAFC;             -fx-border-color: #D4AF37;             -fx-border-width: 6;         " xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="client.controller.AccountBalanceController">

    <!-- ================= LEFT MENU ================= -->
    <VBox prefWidth="250.0" spacing="18" style="                 -fx-background-color: #000000;                 -fx-border-color: #D4AF37;                 -fx-border-width: 0 3 0 0;                 -fx-padding: 30 20 20 20;             " AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- TITLE -->
        <VBox alignment="CENTER" spacing="6">

            <Label style="                        -fx-text-fill: white;                        -fx-font-size: 26px;                        -fx-font-weight: bold;                    " text="Auction System">

                <font>
                    <Font name="Berlin Sans FB Demi Bold" size="24.0" />
                </font>

            </Label>

            <Label style="                        -fx-text-fill: #94A3B8;                        -fx-font-size: 13px;                    " text="USER PANEL" />

        </VBox>

        <Separator style="-fx-background-color: #334155;" />

        <!-- PROFILE -->
        <Button fx:id="infoBtn" prefHeight="45" prefWidth="210" style="                     -fx-background-color: #334155;                     -fx-text-fill: white;                     -fx-font-size: 15px;                     -fx-font-family: 'Berlin Sans FB Demi Bold';                     -fx-background-radius: 8;                 " text="Profile" />

        <!-- HISTORY -->
        <Button fx:id="historyBtn" prefHeight="45" prefWidth="210" style="                     -fx-background-color: #334155;                     -fx-text-fill: white;                     -fx-font-size: 15px;                     -fx-font-family: 'Berlin Sans FB Demi Bold';                     -fx-background-radius: 8;                 " text="Auction History" />

        <!-- YOUR AUCTIONS -->
        <Button fx:id="createdAuctionBtn" prefHeight="45" prefWidth="210" style="                     -fx-background-color: #334155;                     -fx-text-fill: white;                     -fx-font-size: 15px;                     -fx-font-family: 'Berlin Sans FB Demi Bold';                     -fx-background-radius: 8;                 " text="My Auctions" />

        <!-- FAVOURITE -->
        <Button fx:id="favoriteBtn" prefHeight="45" prefWidth="210" style="                     -fx-background-color: #334155;                     -fx-text-fill: white;                     -fx-font-size: 15px;                     -fx-font-family: 'Berlin Sans FB Demi Bold';                     -fx-background-radius: 8;                 " text="Favourite" />

        <!-- WALLET -->
        <Button fx:id="balanceBtn" prefHeight="45" prefWidth="210" style="                     -fx-background-color: #475569;                     -fx-text-fill: white;                     -fx-font-size: 15px;                     -fx-font-family: 'Berlin Sans FB Demi Bold';                     -fx-font-weight: bold;                     -fx-background-radius: 8;                 " text="Account Balance" />

        <!-- LOGOUT -->
        <Button fx:id="logoutBtn" prefHeight="48" prefWidth="210" style="                     -fx-background-color: #D4AF37;                     -fx-text-fill: white;                     -fx-font-size: 15px;                     -fx-font-family: 'Berlin Sans FB Demi Bold';                     -fx-background-radius: 8;                 " text="Log Out" />

        <!-- DELETE -->
        <Button fx:id="deleteAccountBtn" prefHeight="48" prefWidth="210" style="                     -fx-background-color: #EF4444;                     -fx-text-fill: white;                     -fx-font-size: 15px;                     -fx-font-family: 'Berlin Sans FB Demi Bold';                     -fx-background-radius: 8;                 " text="DELETE ACCOUNT" />

        <Region VBox.vgrow="ALWAYS" />

        <!-- BACK -->
        <Button fx:id="backHomeBtn" prefHeight="48" prefWidth="210" style="                     -fx-background-color: #2563EB;                     -fx-text-fill: white;                     -fx-font-size: 15px;                     -fx-font-family: 'Berlin Sans FB Demi Bold';                     -fx-background-radius: 8;                 " text="← Back To Home" />

    </VBox>

    <!-- ================= PAGE TITLE ================= -->

    <Label layoutX="290.0" layoutY="35.0" style="                 -fx-font-size: 32px;                 -fx-font-family: 'Berlin Sans FB Demi Bold';                 -fx-font-weight: bold;                 -fx-text-fill: #0F172A;             " text="Electronic Wallet">

        <font>
            <Font name="Berlin Sans FB Demi Bold" size="32.0" />
        </font>

    </Label>

    <!-- ================= BALANCE CARD ================= -->

    <VBox layoutX="290.0" layoutY="100.0" prefWidth="760.0" spacing="10" style="                 -fx-background-color: white;                 -fx-background-radius: 20;                 -fx-border-radius: 20;                 -fx-border-color: #D4AF37;                 -fx-border-width: 2;                 -fx-padding: 25;             ">

        <Label style="                    -fx-text-fill: #64748B;                    -fx-font-size: 18px;                " text="Current Balance" />

        <Label fx:id="balanceLabel" style="                    -fx-text-fill: #16A34A;                    -fx-font-size: 42px;                    -fx-font-weight: bold;                " text="0 USD" />

    </VBox>

    <!-- ================= ACTION AREA ================= -->

    <HBox layoutX="290.0" layoutY="250.0" spacing="25">

        <!-- DEPOSIT -->
        <VBox prefWidth="360" spacing="18" style="                     -fx-background-color: white;                     -fx-background-radius: 18;                     -fx-border-radius: 18;                     -fx-border-color: #D4AF37;                     -fx-border-width: 2;                     -fx-padding: 25;                 ">

            <Label style="                        -fx-font-size: 24px;                        -fx-font-weight: bold;                        -fx-text-fill: #0F172A;                    " text="Deposit Money" />

            <TextField fx:id="depositField" prefHeight="45" promptText="Enter amount" style="                         -fx-background-radius: 10;                         -fx-border-radius: 10;                         -fx-border-color: #CBD5E1;                         -fx-font-size: 15px;                     " />

            <Button fx:id="depositBtn" onAction="#handleDeposit" prefHeight="45" prefWidth="300" style="                         -fx-background-color: #16A34A;                         -fx-text-fill: white;                         -fx-font-size: 15px;                         -fx-font-weight: bold;                         -fx-background-radius: 10;                     " text="Deposit" />
         <HBox.margin>
            <Insets top="10.0" />
         </HBox.margin>

        </VBox>

        <!-- WITHDRAW -->
        <VBox prefWidth="360" spacing="18" style="                     -fx-background-color: white;                     -fx-background-radius: 18;                     -fx-border-radius: 18;                     -fx-border-color: #D4AF37;                     -fx-border-width: 2;                     -fx-padding: 25;                 ">

            <Label style="                        -fx-font-size: 24px;                        -fx-font-weight: bold;                        -fx-text-fill: #0F172A;                    " text="Withdraw Money" />

            <TextField fx:id="withdrawField" prefHeight="45" promptText="Enter amount" style="                         -fx-background-radius: 10;                         -fx-border-radius: 10;                         -fx-border-color: #CBD5E1;                         -fx-font-size: 15px;                     " />

            <Button fx:id="withdrawBtn" onAction="#handleWithdraw" prefHeight="45" prefWidth="300" style="                         -fx-background-color: #EF4444;                         -fx-text-fill: white;                         -fx-font-size: 15px;                         -fx-font-weight: bold;                         -fx-background-radius: 10;                     " text="Withdraw" />
         <HBox.margin>
            <Insets top="10.0" />
         </HBox.margin>
         <padding>
            <Insets top="10.0" />
         </padding>

        </VBox>

    </HBox>

    <!-- ================= TRANSACTION HISTORY ================= -->

    <HBox layoutX="290.0" layoutY="500.0" prefWidth="760.0"
          alignment="CENTER_LEFT">

        <Label text="Transaction History"
               style="-fx-font-size:26px;
                  -fx-font-family:'Berlin Sans FB Demi Bold';
                  -fx-font-weight:bold;
                  -fx-text-fill:#0F172A;" />

        <Region HBox.hgrow="ALWAYS"/>

        <ComboBox fx:id="filterBox"
                  prefWidth="180"
                  promptText="Filter"
                  style="-fx-background-radius:8;" />
    </HBox>
    <ScrollPane fitToWidth="true" layoutX="290.0" layoutY="545.0" prefHeight="145.0" prefWidth="760.0">

        <VBox fx:id="transactionContainer" spacing="15" style="-fx-padding: 5;">

        </VBox>

    </ScrollPane>

</AnchorPane>
